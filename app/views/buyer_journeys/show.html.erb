<% content_for :title, localized_copy("Моето място - личен план | #{product_name}", "My Place - Personal Plan | #{product_name}") %>
<% content_for :description, localized_copy("Личен план за подготовка при покупка на имот, запазен в този браузър.", "Personal Property Purchase Preparation Plan saved in this browser.") %>
<% content_for :head do %><meta name="robots" content="noindex,nofollow"><% end %>

<div class="site-shell education-page journey-page">
  <%= render "education/breadcrumbs", items: [[localized_copy("Моето място", "My place"), nil]] %>

  <% unless @journey %>
    <header class="onboarding-hero">
      <div><p class="eyebrow"><span></span><%= localized_copy("Личен план", "Personal plan") %></p><h1><%= localized_copy("Подреди следващите си стъпки", "Plan your next steps") %></h1><p><%= localized_copy("Отговори на три кратки въпроса и ще получиш насоки според своята ситуация. Допълнителната информация не е задължителна, а имот можеш да добавиш и по-късно.", "Answer three quick questions to get guidance tailored to your situation. The additional details are optional, and you can add a property later.") %></p></div>
      <aside><strong><%= localized_copy("Поверителност", "Privacy") %></strong><p><%= localized_copy("Пазим напредъка в този браузър за #{Rails.application.config.x.anonymous_journey_retention_days} дни. Не ти е нужна регистрация, но планът няма да е достъпен от друго устройство.", "We keep your progress in this browser for #{Rails.application.config.x.anonymous_journey_retention_days} days. No account is required, but your plan will not be available on another device.") %></p></aside>
    </header>
    <% if @onboarding_error %><div class="form-banner" role="alert"><%= @onboarding_error %></div><% end %>
    <%= form_with url: buyer_journeys_path, scope: :buyer_journey, class: "onboarding-form" do |form| %>
      <% property_type_descriptions = {
        "new_build" => localized_copy("Етапи, документи и проверки при строеж в процес", "Stages, documents and inspections during construction in progress"),
        "completed_home" => localized_copy("Собственост, състояние и разходи за готов имот", "Ownership, condition and costs of a finished property"),
        "house" => localized_copy("Терен, сгради, достъп и строителни книжа", "Land, buildings, access and building documents"),
        "land" => localized_copy("Регулация, достъп, ограничения и мрежи", "Regulation, access, restrictions and networks"),
        "undecided" => localized_copy("Ще започнем с общите стъпки", "We'll start with the general steps")
      } %>
      <fieldset>
        <legend><span>01</span><%= localized_copy("Какъв имот разглеждаш?", "What property are you looking at?") %></legend>
        <div class="choice-grid"><% ApplicationHelper::PROPERTY_TYPE_LABELS.each_key do |key| %><label><%= form.radio_button :property_type, key, checked: (@form_values&.fetch("property_type", nil) || "undecided") == key %><span><strong><%= property_type_label(key) %></strong><small><%= property_type_descriptions.fetch(key) %></small></span></label><% end %></div>
      </fieldset>
      <fieldset>
        <legend><span>02</span><%= localized_copy("На какъв етап от покупката си?", "At what stage of your purchase?") %></legend>
        <%= form.select :buyer_stage, options_for_select(ApplicationHelper::BUYER_STAGE_LABELS.keys.map { |key| [buyer_stage_label(key), key] }, @form_values&.fetch("buyer_stage", "researching") || "researching"), {}, class: "form-select" %>
      </fieldset>
      <fieldset>
        <legend><span>03</span><%= localized_copy("Имаш ли конкретен имот?", "Do you have a specific property?") %></legend>
        <div class="choice-grid choice-grid--three">
          <% [["none", localized_copy("Не, още проучвам", "No, I'm still researching")], ["label", localized_copy("Да, но нямам идентификатор", "Yes, but I don't have an ID")], ["identifier", localized_copy("Да, имам идентификатор", "Yes, I have an ID")]].each do |key, label| %>
            <label><%= form.radio_button :property_presence, key, checked: (@form_values&.fetch("property_presence", nil) || "none") == key %><span><strong><%= label %></strong></span></label>
          <% end %>
        </div>
        <div class="optional-fields">
          <div><%= form.label :label, localized_copy("Име на варианта (по избор)", "Variant Name (optional)"), class: "form-label" %><%= form.text_field :label, maxlength: 80, value: @form_values&.fetch("label", nil), placeholder: localized_copy("Напр. Апартаментът до парка", "E.g. The apartment next to the park") %><small><%= localized_copy("Името служи само за твоя ориентир и не се приема за адрес на имота.", "The name is only for your reference and is not accepted as the address of the property.") %></small></div>
          <div><%= form.label :cadastral_identifier, localized_copy("Кадастрален идентификатор (по избор)", "Cadastral ID (optional)"), class: "form-label" %><%= form.text_field :cadastral_identifier, value: @form_values&.fetch("cadastral_identifier", nil), placeholder: "68134.1609.3263.1.10" %><small><%= localized_copy("Ако го въведеш, ще проверим наличните публични данни и ще свържем резултата с плана.", "If you enter it, we'll check the available public data and match the result to the plan.") %></small></div>
        </div>
      </fieldset>
      <details class="optional-context"><summary><%= localized_copy("Допълнителна информация", "Additional information") %> <span><%= localized_copy("по избор", "optional") %></span></summary><div>
        <label><%= localized_copy("Етап на сградата, ако го знаеш", "Building stage, if known") %><%= form.select :user_reported_building_stage, options_for_select(ApplicationHelper::BUILDING_STAGE_LABELS.keys.map { |key| [building_stage_label(key), key] }, "unknown"), {}, class: "form-select" %></label>
        <label><%= localized_copy("Финансиране", "Financing") %><%= form.select :financing_context, options_for_select(ApplicationHelper::FINANCING_LABELS.keys.map { |key| [financing_label(key), key] }, "undecided"), {}, class: "form-select" %></label>
      </div></details>
      <div class="onboarding-form__actions"><%= form.submit localized_copy("Създай моя план", "Create my plan"), class: "button button--primary" %><%= link_to localized_copy("Пропусни и разгледай наръчника", "Skip and check out the manual"), guide_path, class: "text-link" %></div>
    <% end %>
  <% else %>
    <% if @journeys.size > 1 %>
      <nav class="case-switcher" aria-label="<%= localized_copy("Твои планове", "Your plans") %>"><span><%= localized_copy("Твоите варианти", "Your options") %></span><% @journeys.each do |journey| %><%= button_to journey.label.presence || (journey.property_analysis ? localized_copy("Имот #{journey.property_analysis.submitted_identifier}", "Property #{journey.property_analysis.submitted_identifier}") : property_type_label(journey.property_type)), select_buyer_journey_path, method: :patch, params: { journey: journey.public_token }, class: (journey == @journey ? "is-current" : nil) %><% end %></nav>
    <% end %>

    <header class="journey-hero">
      <div><p class="eyebrow"><span></span><%= localized_copy("Моето място", "My place") %></p><h1><%= localized_copy("Твоята подготовка за покупка", "Your purchase preparation") %></h1><div class="journey-context"><span><%= property_type_label(@journey.property_type) %></span><span><%= buyer_stage_label(@journey.buyer_stage) %></span><% if @journey.financing_context %><span><%= financing_label(@journey.financing_context) %></span><% end %></div></div>
      <aside><%= mesto_icon("shield", css_class: "size-5") %><p><strong><%= localized_copy("Запазено в този браузър", "Saved in this browser") %></strong><br><%= localized_copy("Информацията в личния ти план не се показва в споделения отчет.", "The information in your personal plan does not appear in the shared report.") %></p></aside>
    </header>

    <% if @journey.property_analysis %>
      <% analysis = @journey.property_analysis %>
      <section class="connected-property">
        <div><span><%= localized_copy("Свързан отчет", "Related report") %></span><h2><%= @journey.label.presence || analysis.submitted_identifier %></h2><p><%= localized_copy("Статус на анализа:", "Analysis status:") %> <strong><%= t("reports.statuses.#{analysis.status}") %></strong></p></div>
        <%= link_to localized_copy("Отвори отчета", "Open the report"), report_path(analysis), class: "button button--secondary" %>
      </section>
      <section class="evidence-comparison">
        <div><span><%= localized_copy("Посочено от теб", "Mentioned by you") %></span><strong><%= building_stage_label(@journey.user_reported_building_stage) %></strong><small><%= localized_copy("Този етап е твой избор и не идва от официален източник", "This stage is your choice and does not come from an official source") %></small></div>
        <div><span><%= localized_copy("Етап според последния открит документ", "Stage according to the last document found") %></span><strong><%= @presenter.assessment&.milestone ? building_stage_label(@presenter.assessment.milestone) : localized_copy("Не е установен", "Not established") %></strong><small><%= @presenter.assessment&.source_checked_at ? localized_copy("Проверено на #{l(@presenter.assessment.source_checked_at.to_date, format: :short)}", "Checked on #{l(@presenter.assessment.source_checked_at.to_date, format: :short)}") : localized_copy("Източниците още не са проверени", "Sources not yet verified") %></small></div>
      </section>
      <% if @presenter.assessment&.conflict_flags&.include?("later_evidence_than_reported") %>
        <section class="evidence-conflict" role="status"><h2><%= localized_copy("Открихме документ за по-късен етап", "We found a document for a later stage") %></h2><p><%= localized_copy("Ти посочи #{building_stage_label(@journey.user_reported_building_stage)}, но открихме документ за #{building_stage_label(@presenter.assessment.milestone)}, който изглежда свързан с тази сграда. Провери за коя част от строежа се отнася документът и кой е официалният му източник.", "You selected #{building_stage_label(@journey.user_reported_building_stage)}, but we found a document for #{building_stage_label(@presenter.assessment.milestone)} that appears to relate to this building. Check which part of the development the document covers and confirm its official source.") %></p><div><%= link_to localized_copy("Виж документа", "View the document"), report_path(analysis, anchor: "records"), class: "button button--secondary" %><%= button_to localized_copy("Приеми открития етап", "Use the detected stage"), buyer_journey_path, method: :patch, params: { buyer_journey: { user_reported_building_stage: @presenter.assessment.milestone }, suggestion_action: "accepted" }, class: "button button--primary" %><%= button_to localized_copy("Запази моя избор", "Keep my selection"), buyer_journey_path, method: :patch, params: { buyer_journey: { user_reported_building_stage: @journey.user_reported_building_stage }, suggestion_action: "dismissed" }, class: "button button--subtle" %><%= button_to localized_copy("Не съм сигурен", "I'm not sure"), buyer_journey_path, method: :patch, params: { buyer_journey: { user_reported_building_stage: "unknown" }, suggestion_action: "dismissed" }, class: "button button--subtle" %></div><small><%= localized_copy("Няма да променим избрания етап без твое действие.", "We will not change your selected stage unless you choose to do so.") %></small></section>
      <% end %>
      <% @presenter.assessment&.limitations&.each do |limitation| %><p class="evidence-limit"><%= limitation %></p><% end %>
    <% end %>

    <section class="journey-section priorities">
      <div class="journey-section__heading"><div><p class="eyebrow"><span></span><%= localized_copy("01 · Сега", "01 · Now") %></p><h2><%= localized_copy("Най-важното за теб в момента", "The most important thing for you right now") %></h2></div><p><%= localized_copy("Тези препоръки са съобразени с избраната от теб ситуация. Те не определят дали имотът е безрисков или сделката е готова за подписване.", "These recommendations are tailored to your chosen situation. They do not determine if the property is risk free or if the deal is ready to sign.") %></p></div>
      <div class="priority-list"><% @presenter.priority_recommendations.each_with_index do |item, index| %><article><span><%= format("%02d", index + 1) %></span><div><h3><%= link_to item["title"], education_path_for(item) %></h3><p><%= item["summary"] %></p><small><%= localized_copy("Защо виждаш това?", "Why are you seeing this?") %> <%= item["reason"] %></small></div><%= button_to localized_copy("Прочетено", "Mark as read"), buyer_journey_progress_path, method: :patch, params: { item_kind: "lesson", item_key: item["key"], status: "done", content_version: 1 }, class: "priority-list__mark" %></article><% end %></div>
    </section>

    <% if @presenter.concepts.any? %>
      <section class="journey-section concept-section">
        <div class="journey-section__heading"><div><p class="eyebrow"><span></span><%= localized_copy("02 · Разбери", "02 · Understand") %></p><h2><%= localized_copy("Разбери тези понятия", "Understand these concepts") %></h2></div><p><%= localized_copy("Кратки обяснения за документите и термините, които са подходящи за избрания от теб етап.", "Brief explanations of the documents and terms relevant to your current stage.") %></p></div>
        <div class="concept-grid"><% @presenter.concepts.each do |item| %><%= link_to education_path_for(item) do %><span><%= item["path_kind"] == "term" ? localized_copy("Термин", "Term") : localized_copy("Документ", "Document") %></span><strong><%= item["title"] %></strong><small><%= item["reason"] %></small><% end %><% end %></div>
      </section>
    <% end %>

    <section class="journey-section checklist-section">
      <div class="journey-section__heading"><div><p class="eyebrow"><span></span><%= localized_copy("03 · Провери и действай", "03 · Check and act") %></p><h2><%= localized_copy("Списък за проверка", "Checklist") %></h2></div><p><%= localized_copy("Отбелязал си", "You have completed") %> <strong><%= @presenter.completed_task_count %> <%= localized_copy("от", "of") %> <%= @presenter.checklist.length %></strong> <%= localized_copy("задачи. Това е твоят личен напредък, а не оценка на имота.", "tasks. This is your personal progress, not an assessment of the property.") %></p></div>
      <div class="checklist-list"><% @presenter.checklist.each do |item| %><article class="<%= 'is-done' if item['user_progress'] == 'done' %> <%= 'is-later' unless item['applicability'] == 'relevant_now' %>"><div class="checklist-list__state"><span><%= item["user_progress"] == "done" ? mesto_icon("check", css_class: "size-4") : "" %></span></div><div><h3><%= item["title"] %></h3><p><%= item["reason"] %></p><dl><div><dt><%= localized_copy("Приложимост", "Applicability") %></dt><dd><%= checklist_applicability_label(item["applicability"]) %></dd></div><div><dt><%= localized_copy("Към кого да се обърнеш", "Who to turn to") %></dt><dd><%= item["responsible"] %></dd></div><div><dt><%= localized_copy("Статус на проверката", "Check status") %></dt><dd><%= evidence_status_label(item.dig("evidence", "status")) %></dd></div></dl></div><%= button_to(item["user_progress"] == "done" ? localized_copy("Отмени отметката", "Uncheck") : localized_copy("Отбележи като готово", "Mark as done"), buyer_journey_progress_path, method: :patch, params: { item_kind: "task", item_key: item["key"], status: (item["user_progress"] == "done" ? "not_started" : "done"), content_version: item["content_version"] }, class: "checklist-list__button") %></article><% end %></div>
    </section>

    <% if @presenter.questions.any? %><section class="journey-section questions-panel" data-controller="clipboard"><div><p class="eyebrow"><span></span><%= localized_copy("04 · Следващ разговор", "04 · Next conversation") %></p><h2><%= localized_copy("Въпроси към продавача или специалист", "Questions to the seller or specialist") %></h2><p><%= localized_copy("Копирай списъка, допълни го според конкретния имот и го използвай при следващия разговор.", "Copy the list, supplement it according to the specific property and use it in the next conversation.") %></p></div><textarea readonly data-clipboard-target="source"><%= @presenter.questions.map { |question| "• #{question}" }.join("\n") %></textarea><button type="button" class="button button--secondary" data-action="clipboard#copy"><%= localized_copy("Копирай списъка", "Copy the list") %></button><span class="copy-status" data-clipboard-target="status" aria-live="polite"></span></section><% end %>

    <section class="journey-section next-view">
      <p class="eyebrow"><span></span><%= localized_copy("05 · Твоят етап", "05 · Your stage") %></p><h2><%= localized_copy("Преди, сега, следва", "Before, now, next") %></h2><div><span><small><%= localized_copy("Преди", "Before") %></small><%= @presenter.previous_buyer_stage ? buyer_stage_label(@presenter.previous_buyer_stage) : "-" %></span><span class="is-current"><small><%= localized_copy("Сега", "Now") %></small><%= buyer_stage_label(@presenter.buyer_stage) %></span><span><small><%= localized_copy("Следва", "Next up") %></small><%= @presenter.next_buyer_stage ? buyer_stage_label(@presenter.next_buyer_stage) : "-" %></span></div><p><%= localized_copy("Това е само ориентир, а не задължителна последователност. Можеш да промениш избрания етап по всяко време.", "This is only a guideline, not a mandatory sequence. You can change the selected stage at any time.") %></p>
    </section>

    <% unless @journey.property_analysis %><section class="journey-section attach-property"><div><p class="eyebrow"><span></span><%= localized_copy("06 · Когато си готов", "06 · When you're ready") %></p><h2><%= localized_copy("Добави имот, без да започваш отначало", "Add a property without starting over") %></h2><p><%= localized_copy("Отбелязаните от теб теми и задачи ще останат. Ще добавим препоръки според наличните публични данни за имота.", "The topics and tasks marked by you will remain. We will add recommendations based on available public property data.") %></p></div><%= form_with url: property_analyses_path, method: :post do |form| %><%= hidden_field_tag :attach_to_journey, "1" %><%= form.label :cadastral_identifier, localized_copy("Кадастрален идентификатор", "Cadastral identifier"), class: "form-label" %><div><%= form.text_field :cadastral_identifier, required: true, placeholder: "68134.1609.3263.1.10" %><%= form.submit localized_copy("Добави и провери", "Add and check"), class: "button button--primary" %></div><small><%= localized_copy("Ако свържеш различен имот по-късно, ще създадем отделен вариант.", "If you link a different property later, we'll create a separate variant.") %></small><% end %></section><% end %>

    <details class="journey-settings"><summary><%= localized_copy("Промени избраната информация или управлявай данните", "Change selected information or manage data") %></summary><div>
      <%= form_with model: @journey, url: buyer_journey_path, method: :patch, class: "context-form" do |form| %>
        <label><%= localized_copy("Какъв имот?", "What type of property?") %><%= form.select :property_type, options_for_select(ApplicationHelper::PROPERTY_TYPE_LABELS.keys.map { |key| [property_type_label(key), key] }, @journey.property_type), {}, class: "form-select" %></label>
        <label><%= localized_copy("На какъв етап от покупката си?", "Where are you in the buying process?") %><%= form.select :buyer_stage, options_for_select(ApplicationHelper::BUYER_STAGE_LABELS.keys.map { |key| [buyer_stage_label(key), key] }, @journey.buyer_stage), {}, class: "form-select" %></label>
        <label><%= localized_copy("Етап на сградата, ако го знаеш", "Building stage, if known") %><%= form.select :user_reported_building_stage, options_for_select(ApplicationHelper::BUILDING_STAGE_LABELS.keys.map { |key| [building_stage_label(key), key] }, @journey.user_reported_building_stage || "unknown"), {}, class: "form-select" %></label>
        <label><%= localized_copy("Финансиране", "Financing") %><%= form.select :financing_context, options_for_select(ApplicationHelper::FINANCING_LABELS.keys.map { |key| [financing_label(key), key] }, @journey.financing_context || "undecided"), {}, class: "form-select" %></label>
        <%= form.submit localized_copy("Запази промените", "Save the changes"), class: "button button--secondary" %>
      <% end %>
      <div class="data-actions"><%= button_to localized_copy("Нулирай отметките", "Reset progress"), reset_buyer_journey_path, method: :delete, class: "text-button" %><%= button_to localized_copy("Изтрий този личен план", "Delete this personal plan"), buyer_journey_path, method: :delete, class: "text-button text-button--danger", form: { data: { turbo_confirm: localized_copy("Сигурен ли си, че искаш да изтриеш личния план и напредъка?", "Are you sure you want to delete this personal plan and its progress?") } } %></div>
    </div></details>
  <% end %>
</div>
