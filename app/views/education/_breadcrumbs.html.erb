<nav class="breadcrumbs" aria-label="<%= localized_copy("Навигационна пътека", "Breadcrumbs") %>">
  <%= link_to t("navigation.home"), root_path %><span aria-hidden="true">/</span>
  <%= link_to t("navigation.guides"), guide_path %>
  <% Array(items).each do |label, path| %>
    <span aria-hidden="true">/</span>
    <% if path %><%= link_to label, path %><% else %><span aria-current="page"><%= label %></span><% end %>
  <% end %>
</nav>
