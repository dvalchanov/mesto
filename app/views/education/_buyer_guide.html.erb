<% anchor = guide["buyer_stage"].presence || guide["slug"] %>
<% related = (Array(guide["related_document_keys"]) + Array(guide["related_term_keys"]) + Array(guide["related_stage_keys"])).uniq.filter_map { |key| @catalog.find(key) } %>
<% guide_sources = Array(guide["source_ids"]).filter_map { |source_id| @catalog.source(source_id) } %>

<article id="<%= anchor %>" class="buyer-guide">
  <header>
    <span class="buyer-guide__kicker"><b><%= format("%02d", index + 1) %></b><%= guide["category"] == "property_type" ? "Маршрут според имота" : "Контекст за купувача" %></span>
    <h2><%= guide["title"] %></h2>
    <p><%= guide["summary"] %></p>
  </header>

  <div class="buyer-guide__body">
    <section class="buyer-guide__opening">
      <span>Как да прочетеш ситуацията</span>
      <%= education_prose(guide.dig("sections", "understand")) %>
    </section>

    <div class="buyer-guide__evidence">
      <section>
        <span>Какво трябва да установиш</span>
        <h3>Провери фактите</h3>
        <%= education_prose(guide.dig("sections", "verify")) %>
      </section>
      <section>
        <span>Какво да събереш</span>
        <h3>Документи и следа</h3>
        <%= education_prose(guide.dig("sections", "documents")) %>
      </section>
    </div>

    <section class="buyer-guide__money">
      <div><span>Бюджет и договорна граница</span><h3>Какво може да промени общия ангажимент?</h3></div>
      <div class="buyer-guide__prose"><%= education_prose(guide.dig("sections", "money")) %></div>
    </section>

    <section class="buyer-guide__risk">
      <div><span>Сигнали за внимание</span><h3>Къде да забавиш решението?</h3></div>
      <div class="buyer-guide__prose"><%= education_prose(guide.dig("sections", "risks")) %></div>
    </section>

    <div class="buyer-guide__support">
      <section><span>Кой може да помогне?</span><%= education_prose(guide.dig("sections", "professionals")) %></section>
      <section><span>Как да действаш?</span><%= education_prose(guide.dig("sections", "act")) %></section>
    </div>

    <% if related.any? %>
      <section class="buyer-guide__related">
        <div><span>Отвори само когато ти трябва</span><h3>Свързани документи, термини и етапи</h3></div>
        <div>
          <% related.each do |item| %>
            <%= link_to education_path_for(item) do %>
              <small><%= { "document" => "Документ", "term" => "Термин", "stage" => "Строителен етап" }.fetch(item["kind"], "Насока") %></small>
              <strong><%= item["title"] %></strong>
            <% end %>
          <% end %>
        </div>
      </section>
    <% end %>

    <section class="buyer-guide__next">
      <div><span>Когато продължиш</span><h3>Какво следва оттук?</h3></div>
      <div class="buyer-guide__prose"><%= education_prose(guide.dig("sections", "next")) %></div>
    </section>

    <details class="buyer-guide__sources">
      <summary>Официални източници и редакционен статус</summary>
      <div>
        <p>Насоката е образователна. Преди плащане или подписване приложимостта към конкретния имот и договор трябва да бъде прегледана от квалифициран специалист.</p>
        <ul>
          <% guide_sources.each do |source| %>
            <li>
              <%= link_to source["title"], source["url"], target: "_blank", rel: "noopener noreferrer" %>
              <span><%= education_source_date(source) %> · Проверено от Mesto: <%= l(Date.iso8601(source["checked_at"]), format: :short) %></span>
            </li>
          <% end %>
        </ul>
        <p class="buyer-guide__sources-status">Версия <%= guide["content_version"] %> · Редакционен статус: публикувано · Професионален преглед: предстои</p>
      </div>
    </details>

    <section class="buyer-guide__checks">
      <div><span>Преди следващата стъпка</span><h3>Провери това</h3><p>Това е подготовка за решение и разговор със специалист, не автоматично потвърждение за имота.</p></div>
      <ol>
        <% Array(guide.dig("sections", "buyer_checks")).each_with_index do |check, check_index| %>
          <li><span><%= format("%02d", check_index + 1) %></span><p><%= check %></p></li>
        <% end %>
      </ol>
    </section>

    <nav class="buyer-guide__navigation" aria-label="Навигация от <%= guide['title'] %>">
      <% if previous_guide %><%= link_to buying_guide_path(anchor: previous_guide["buyer_stage"].presence || previous_guide["slug"]) do %><span>Назад</span><strong><%= previous_guide["title"] %></strong><% end %><% else %><%= link_to buying_guide_path(anchor: "buyer-guide-start") do %><span>Назад</span><strong>Избери отправна точка</strong><% end %><% end %>
      <%= link_to buying_guide_path(anchor: "buyer-guide-start"), class: "buyer-guide__all" do %><span>Всички маршрути</span><strong>Върни се към избора</strong><% end %>
      <% if next_guide %><%= link_to buying_guide_path(anchor: next_guide["buyer_stage"].presence || next_guide["slug"]) do %><span>Напред</span><strong><%= next_guide["title"] %></strong><% end %><% else %><%= link_to guide_path do %><span>Разгледай отново</span><strong>Начало на наръчника</strong><% end %><% end %>
    </nav>
  </div>
</article>
