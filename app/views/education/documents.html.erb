<% content_for :title, localized_copy("Документи при покупка на имот | #{product_name}", "Property Documents in Bulgaria: Buyer Guide | #{product_name}") %>
<% content_for :description, localized_copy("Разбери какво доказват нотариалният акт, удостоверението за тежести, кадастралната схема, строителните книжа и договорите при покупка.", "Understand the title deed, encumbrance certificate, cadastral scheme, construction documents and contracts used when buying property in Bulgaria.") %>
<% if @query.present? %><% content_for :head do %><meta name="robots" content="noindex,follow"><% end %><% end %>

<div class="site-shell education-page library-page">
  <%= render "breadcrumbs", items: [[t("navigation.documents"), nil]] %>
  <header class="library-hero">
    <div><p class="eyebrow"><span></span><%= t("navigation.documents") %></p><h1><%= localized_copy("Разбери какво доказва всеки документ", "Understand what each document proves") %></h1><p><%= localized_copy("Виж кога се използва, кои данни трябва да сравниш и какво не можеш да заключиш само от него.", "See when it is used, which details to compare and what you cannot conclude from that document alone.") %></p></div>
    <%= form_with url: education_documents_path, method: :get, class: "education-search" do |form| %>
      <%= form.label :q, localized_copy("Търси по име, съкращение или въпрос", "Search by name, abbreviation or question"), class: "form-label" %>
      <div class="education-search__field"><%= mesto_icon("search", css_class: "size-5") %><%= form.search_field :q, value: @query, placeholder: localized_copy("Напр. акт16, схема, тежести…", "E.g. Act 16, cadastral scheme, encumbrances…") %><%= form.submit localized_copy("Търси", "Search"), class: "button button--secondary" %></div>
    <% end %>
  </header>

  <% groups = education_document_groups(@entries) %>
  <% if groups.any? %>
    <% if @query.present? %><p class="search-summary"><%= localized_copy("Намерени резултати за „#{@query}“:", "Results for “#{@query}”:") %> <strong><%= @entries.length %></strong></p><% end %>
    <nav class="library-category-nav" aria-label="<%= localized_copy("Групи документи", "Document groups") %>">
      <% groups.each do |group| %><a href="#documents-<%= group[:key] %>"><span><%= format("%02d", group[:entries].length) %></span><%= group[:label] %></a><% end %>
    </nav>
    <div class="library-groups">
      <% groups.each do |group| %>
        <section id="documents-<%= group[:key] %>" class="library-group">
          <header class="library-group__heading"><div><p class="eyebrow"><span></span><%= group[:label] %></p><h2><%= group[:title] %></h2></div><p><%= group[:description] %></p></header>
          <div class="content-index">
            <% group[:entries].each do |entry| %>
              <%= link_to education_path_for(entry) do %>
                <% kind_label = { "term" => localized_copy("Термин", "Term"), "stage" => localized_copy("Строителен етап", "Construction stage"), "guide" => localized_copy("Насока за купувача", "Buyer guidance") }[entry["kind"]] %>
                <% if kind_label %><span><%= kind_label %></span><% end %>
                <h3><%= entry["title"] %></h3><p><%= entry["summary"] %></p>
              <% end %>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state"><h2><%= localized_copy("Не намерихме такъв документ", "We couldn't find that document") %></h2><p><%= localized_copy("Опитай с друго изписване, съкращение или дума от въпроса, който искаш да изясниш.", "Try a different spelling, an abbreviation or a word from the question you want to answer.") %></p><%= link_to localized_copy("Виж термините", "Browse the glossary"), terms_path, class: "button button--secondary" %></div>
  <% end %>
</div>
