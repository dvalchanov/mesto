<% content_for :title, localized_copy("#{@stage['title']} - какво означава | #{product_name}", "#{@stage['title']} - what it means | #{product_name}") %>
<% content_for :description, @stage["summary"] %>

<div class="site-shell education-page stage-page">
  <%= render "breadcrumbs", items: [[localized_copy("Ново строителство", "New construction"), new_build_guide_path], [@stage["title"], nil]] %>
  <header class="stage-hero">
    <div>
      <p class="eyebrow"><span></span><%= localized_copy("Етап", "Stage") %> <%= @stage["position"] %> <%= localized_copy("от 8", "of 8") %></p>
      <h1><%= @stage["title"] %></h1>
      <p class="stage-hero__answer"><%= @stage.dig("sections", "concise_answer") %></p>
    </div>
    <aside>
      <span><%= localized_copy("Най-важното накратко", "Key points at a glance") %></span>
      <ul><% @stage.dig("sections", "key_points").each do |point| %><li><%= mesto_icon("check", css_class: "size-4") %><%= point %></li><% end %></ul>
    </aside>
  </header>

  <section class="stage-context">
    <div><span><%= localized_copy("Текуща тема", "Current topic") %></span><strong><%= @stage["title"] %></strong></div>
    <%= form_with url: new_build_stage_path(@stage["slug"]), method: :get do |form| %>
      <%= form.label :buyer_stage, localized_copy("Къде си в покупката?", "Where are you in the purchase process?") %>
      <%= form.select :buyer_stage, options_for_select(BuyerJourney::GUIDED_BUYER_STAGES.map { |key| [buyer_stage_label(key), key] }, @buyer_stage), {}, onchange: "this.form.requestSubmit()" %>
      <noscript><%= form.submit localized_copy("Покажи насоките", "Show guidance") %></noscript>
    <% end %>
    <div class="stage-context__action"><span><%= localized_copy("Какво да направиш сега", "What to do now") %></span><p><%= @stage.fetch("actions_by_buyer_stage", {}).fetch(@buyer_stage, @stage.dig("actions_by_buyer_stage", "default")) %></p></div>
    <% if @journey %><p class="stage-context__note"><%= localized_copy("Този избор променя само съвета на страницата. В личния ти план е записано:", "This choice only changes the guidance on this page. Your personal plan currently says:") %> “<%= buyer_stage_label(@journey.buyer_stage) %>”. <%= link_to localized_copy("Промени личния план", "Change my personal plan"), my_mesto_path %>.</p><% else %><p class="stage-context__note"><%= localized_copy("Изборът важи само за тази страница. Създай личен план, ако искаш да го запазиш.", "This choice only applies to this page. Create a personal plan if you want to save it.") %></p><% end %>
  </section>

  <section class="stage-position" aria-labelledby="position-title">
    <h2 id="position-title"><%= localized_copy("Къде се намира този етап", "Where this stage fits") %></h2>
    <%= render "building_timeline", stages: @stages, selected_key: @stage["key"] %>
  </section>

  <% related_documents = Array(@stage["related_document_keys"]).filter_map { |key| @catalog.find(key) } %>
  <% related_terms = Array(@stage["related_term_keys"]).filter_map { |key| @catalog.find(key) } %>
  <article class="stage-article">
    <section class="stage-explainer" aria-labelledby="stage-physical-title">
      <header class="article-section-heading">
        <p class="eyebrow"><span></span><%= localized_copy("Как протича етапът", "How this stage unfolds") %></p>
        <h2 id="stage-physical-title"><%= localized_copy("Какво се случва на строежа?", "What happens on site?") %></h2>
        <p><%= localized_copy("Видимите строителни работи и документите, които удостоверяват определени събития, са свързани, но не означават едно и също. Провери и двете поотделно.", "Visible construction work and the documents recording specific events are connected, but they are not the same thing. Check each separately.") %></p>
      </header>
      <div class="stage-explainer__grid">
        <div class="stage-narrative">
          <span class="section-kicker"><%= localized_copy("Строителни работи", "Construction work") %></span>
          <%= education_prose(@stage.dig("sections", "physical")) %>
        </div>
        <aside class="stage-document-trail">
          <span class="section-kicker"><%= localized_copy("Свързани документи", "Related documents") %></span>
          <%= education_prose(@stage.dig("sections", "documents")) %>
          <% if related_documents.any? %>
            <div class="inline-reading-list">
              <% related_documents.each do |document| %>
                <%= link_to education_document_path(document["slug"]), target: "_blank", rel: "noopener noreferrer" do %>
                  <span><%= localized_copy("Научи повече за документа", "Learn more about this document") %></span><strong><%= document["title"] %></strong><small><%= document["summary"] %></small>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <p class="scope-note"><%= localized_copy("Няма един документ, който сам да доказва целия етап. Прегледай строителните книжа, които се отнасят до конкретния строеж.", "No single document proves an entire stage. Review the construction records that apply to the specific project.") %></p>
          <% end %>
        </aside>
      </div>
    </section>

    <section class="stage-buyer-lens" aria-labelledby="stage-buyer-title">
      <div>
        <p class="eyebrow"><span></span><%= localized_copy("За купувача", "For the buyer") %></p>
        <h2 id="stage-buyer-title"><%= localized_copy("Защо е важно за купувача?", "Why does it matter to the buyer?") %></h2>
        <%= education_prose(@stage.dig("sections", "importance")) %>
      </div>
      <aside>
        <span><%= localized_copy("Важно уточнение", "Important distinction") %></span>
        <h3><%= localized_copy("Какво не означава този етап?", "What does this stage not mean?") %></h3>
        <%= education_prose(@stage.dig("sections", "not_meaning")) %>
      </aside>
    </section>

    <section class="stage-support <%= 'stage-support--single' if related_terms.empty? %>">
      <div><span class="section-kicker"><%= localized_copy("Кой може да помогне?", "Who can help?") %></span><%= education_prose(@stage.dig("sections", "helpers")) %></div>
      <% if related_terms.any? %>
        <div><span class="section-kicker"><%= localized_copy("Термини, които ще срещнеш", "Terms you will encounter") %></span><div class="term-pills"><% related_terms.each do |term| %><%= link_to term["title"], term_path(term["slug"]), target: "_blank", rel: "noopener noreferrer" %><% end %></div></div>
      <% end %>
    </section>

    <section class="stage-next-step">
      <div><p class="eyebrow eyebrow--light"><span></span><%= localized_copy("Следващ етап", "Next stage") %></p><h2><%= localized_copy("Какво обикновено следва?", "What usually comes next?") %></h2></div>
      <%= education_prose(@stage.dig("sections", "next")) %>
    </section>

    <section class="stage-investigation" aria-labelledby="stage-investigation-title">
      <header class="article-section-heading">
        <p class="eyebrow"><span></span><%= localized_copy("Преди да разчиташ на етапа", "Before relying on this stage") %></p>
        <h2 id="stage-investigation-title"><%= localized_copy("Какво трябва да изясниш?", "What do you need to clarify?") %></h2>
        <%= education_prose(@stage.dig("sections", "discover")) %>
      </header>
      <div class="stage-checklist">
        <div><span><%= localized_copy("Преди да продължиш", "Before you continue") %></span><h3><%= localized_copy("Списък за проверка", "Checklist") %></h3><p><%= localized_copy("Използвай списъка при разговор с продавача или специалист. Отметката показва само твоя напредък - тя не удостоверява състоянието на имота или строежа.", "Use this list when speaking with the seller or a specialist. A tick only records your progress; it does not verify the condition of the property or the works.") %></p></div>
        <ol>
          <% Array(@stage.dig("sections", "verify")).each_with_index do |item, index| %>
            <li><span><%= format("%02d", index + 1) %></span><p><%= item %></p></li>
          <% end %>
        </ol>
      </div>
    </section>
  </article>

  <% if @journey %>
    <div class="lesson-action">
      <div><strong><%= localized_copy("Полезно ли ти беше?", "Was this helpful?") %></strong><p><%= localized_copy("Отбелязването пази само учебния ти напредък. То не проверява документ или имот.", "This only saves your learning progress. It does not verify a document or property.") %></p></div>
      <%= button_to localized_copy("Отбележи като прочетено", "Mark as read"), buyer_journey_progress_path, method: :patch, params: { item_kind: "lesson", item_key: @stage["key"], status: "done", content_version: @stage["content_version"] }, class: "button button--secondary" %>
    </div>
  <% else %>
    <div class="lesson-action"><div><strong><%= localized_copy("Запази това в личен план", "Save this to a personal plan") %></strong><p><%= localized_copy("Напредъкът се пази в този браузър и може да бъде изтрит по всяко време.", "Progress is saved in this browser and can be deleted at any time.") %></p></div><%= link_to localized_copy("Създай план", "Create a plan"), my_mesto_path, class: "button button--secondary" %></div>
  <% end %>

  <nav class="stage-neighbors" aria-label="<%= localized_copy("Съседни етапи", "Adjacent stages") %>">
    <% current_index = @stages.index(@stage) %>
    <% if current_index&.positive? %><%= link_to new_build_stage_path(@stages[current_index - 1]["slug"]) do %><span><%= localized_copy("Преди", "Previous") %></span><strong><%= @stages[current_index - 1]["title"] %></strong><% end %><% else %><span></span><% end %>
    <% if current_index && current_index < @stages.length - 1 %><%= link_to new_build_stage_path(@stages[current_index + 1]["slug"]) do %><span><%= localized_copy("Следва", "Next") %></span><strong><%= @stages[current_index + 1]["title"] %></strong><% end %><% end %>
  </nav>

  <%= render "sources", entry: @stage, catalog: @catalog %>

  <section class="guide-explore-again guide-explore-again--light">
    <div><p class="eyebrow"><span></span><%= localized_copy("Още полезна информация", "More useful information") %></p><h2><%= localized_copy("Разгледай друг етап или се върни към своята покупка", "Explore another stage or return to your purchase") %></h2><p><%= localized_copy("Можеш да продължиш към друг строителен етап, да видиш насоки според своя етап като купувач или да потърсиш конкретен документ или термин.", "Continue to another construction stage, view guidance for your purchase stage or find a specific document or term.") %></p></div>
    <nav><%= link_to localized_copy("Всички строителни етапи", "All construction stages"), new_build_guide_path %><%= link_to localized_copy("Пътят на купувача", "The buyer's journey"), buying_guide_path %><%= link_to localized_copy("Начало на наръчника", "Guide home"), guide_path %><%= link_to localized_copy("Документи и термини", "Documents and terms"), education_documents_path %></nav>
  </section>
</div>
