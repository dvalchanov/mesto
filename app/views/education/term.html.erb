<% content_for :title, "#{@entry['title']} — значение | #{product_name}" %>
<% content_for :description, @entry["summary"] %>

<div class="site-shell education-page article-page term-page">
  <%= render "breadcrumbs", items: [["Термини", terms_path], [@entry["title"], nil]] %>
  <header class="article-hero term-hero"><p class="eyebrow"><span></span>Термин · <%= education_term_category_label(@entry["category"]) %></p><h1><%= @entry["title"] %></h1><p><%= @entry["summary"] %></p><div class="term-definition"><span>Определение</span><%= education_prose(@entry.dig("sections", "definition")) %></div></header>
  <article class="term-article">
    <section class="term-example"><div><p class="eyebrow"><span></span>Пример</p><h2>Как изглежда на практика?</h2></div><%= education_prose(@entry.dig("sections", "example")) %></section>
    <section class="term-contrast">
      <div><span>Често объркване</span><h2>С какво често се бърка?</h2><%= education_prose(@entry.dig("sections", "confusion")) %></div>
      <div><span>Практическо значение</span><h2>Защо има значение?</h2><%= education_prose(@entry.dig("sections", "importance")) %></div>
    </section>
    <section class="term-next"><div><p class="eyebrow"><span></span>Какво да попиташ</p><h2>Какво да провериш след това?</h2></div><%= education_prose(@entry.dig("sections", "related")) %></section>
  </article>
  <% related = (Array(@entry["related_document_keys"]) + Array(@entry["related_stage_keys"]) + Array(@entry["related_term_keys"])).uniq %>
  <% if related.any? %><section class="related-content"><h2>Свързани теми</h2><div><% related.each do |key| %><% item = @catalog.find(key) %><%= link_to education_path_for(item), target: "_blank", rel: "noopener noreferrer" do %><span><%= { "stage" => "Етап", "term" => "Термин" }.fetch(item["kind"], "Документ") %></span><strong><%= item["title"] %></strong><% end %><% end %></div></section><% end %>
  <%= render "sources", entry: @entry, catalog: @catalog %>
</div>
