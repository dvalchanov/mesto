<% content_for :title, "Наръчник за покупка на имот — #{product_name}" %>
<% content_for :description, "Покупката на имот, стъпка по стъпка: строителни етапи, документи, термини и личен план без задължителен имот." %>

<section class="education-hero">
  <div class="site-shell education-hero__grid">
    <div>
      <p class="eyebrow"><span></span>Наръчник на Mesto</p>
      <h1>Покупката на имот, стъпка по стъпка.</h1>
      <p>Не е нужно вече да имаш избран имот. Започни от своята ситуация, вида на имота или строителния етап и винаги можеш да се върнеш към общата карта.</p>
      <div class="education-actions">
        <%= link_to "Избери моята ситуация", buying_guide_path(anchor: "buyer-guide-start"), class: "button button--primary" %>
        <%= link_to "Виж строителните етапи", new_build_guide_path, class: "button button--ink" %>
        <%= link_to "Подреди личен план", my_mesto_path, class: "text-link" %>
        <%= link_to "Имам имот за проверка", root_path(education_entry: "guide", anchor: "property-check"), class: "text-link" %>
      </div>
    </div>
    <div class="education-principle" aria-label="Подходът на Mesto">
      <% %w[Разбери Провери Действай Следва].each_with_index do |word, index| %>
        <span><b><%= format("%02d", index + 1) %></b><%= word %></span>
      <% end %>
    </div>
  </div>
</section>

<div class="site-shell education-page">
  <% if current_buyer_journey %>
    <section class="resume-card">
      <div><p class="eyebrow"><span></span>Запазен план</p><h2>Продължи от твоя контекст</h2><p><%= property_type_label(current_buyer_journey.property_type) %> · <%= buyer_stage_label(current_buyer_journey.buyer_stage) %></p></div>
      <%= link_to "Отвори Моето място", my_mesto_path, class: "button button--primary" %>
    </section>
  <% end %>

  <section class="education-section">
    <div class="section-heading section-heading--split">
      <div><p class="eyebrow"><span></span>Две независими линии</p><h2>Къде е сградата и къде си ти?</h2></div>
      <p>Строителният етап не определя твоята покупателна ситуация. Разглеждай ги отделно и ги свързвай само с проверими факти.</p>
    </div>
    <div class="dual-journeys">
      <article>
        <span class="dual-journeys__label">01 · Сграда и проект</span>
        <h3>Новото строителство</h3>
        <p>Осем образователни етапа — от терена до предаването. Това не е универсален график или процент завършеност.</p>
        <ol><% @stages.each do |stage| %><li><%= link_to stage["title"], new_build_stage_path(stage["slug"]) %></li><% end %></ol>
        <%= link_to "Виж цялата строителна линия", new_build_guide_path, class: "text-link" %>
      </article>
      <article>
        <span class="dual-journeys__label">02 · Твоето решение</span>
        <h3>Пътят на купувача</h3>
        <p>Контекст за следващия разговор — не правна машина от задължителни стъпки. Можеш да сменяш, пропускаш и преглеждаш назад.</p>
        <ol><% @buyer_guides.each do |guide| %><li><%= link_to guide["title"], buying_guide_path(anchor: guide["buyer_stage"]) %></li><% end %></ol>
        <%= link_to "Разгледай пътя на купувача", buying_guide_path, class: "text-link" %>
      </article>
    </div>
    <div class="property-route-preview">
      <div><span>Имотът също променя въпросите</span><strong>Добави правилния маршрут към своя момент</strong></div>
      <% @property_guides.each do |guide| %><%= link_to buying_guide_path(anchor: guide["slug"]) do %><span><%= Array(guide["property_types"]).map { |type| property_type_label(type) }.join(" · ") %></span><strong><%= guide["title"] %></strong><% end %><% end %>
    </div>
  </section>

  <section class="education-section situations">
    <div class="section-heading"><p class="eyebrow"><span></span>Чести отправни точки</p><h2>Започни от въпроса, който имаш сега</h2></div>
    <div class="situation-grid">
      <%= link_to buying_guide_path(anchor: "researching") do %><span>Само проучвам</span><strong>Тепърва започвам</strong><small>Критерии, бюджет и сравнение</small><% end %>
      <%= link_to buying_guide_path(anchor: "shortlisting") do %><span>Сравнявам</span><strong>Имам няколко варианта</strong><small>Идентичност, състояние и общ разход</small><% end %>
      <%= link_to buying_guide_path(anchor: "before_deposit") do %><span>Преди плащане</span><strong>Предстои ми капаро</strong><small>Получател, условия и изход</small><% end %>
      <%= link_to buying_guide_path(anchor: "before_preliminary_contract") do %><span>Преди договор</span><strong>Получих проект за подписване</strong><small>Предмет, приложения, срокове и изходи</small><% end %>
      <%= link_to buying_guide_path(anchor: "waiting_or_payment") do %><span>След договор</span><strong>Чакам следващо плащане</strong><small>Води конкретната договорна клауза</small><% end %>
      <%= link_to buying_guide_path(anchor: "before_notarial_transfer") do %><span>Преди сделка</span><strong>Подготвям нотариално прехвърляне</strong><small>Актуални проверки, акт и плащане</small><% end %>
      <%= link_to buying_guide_path(anchor: "before_handover") do %><span>Преди ключове</span><strong>Предстои ми предаване</strong><small>Оглед, протокол, дефекти и показания</small><% end %>
      <%= link_to buying_guide_path(anchor: "owner") do %><span>След покупката</span><strong>Вече съм собственик</strong><small>Партиди, гаранции и общи части</small><% end %>
    </div>
    <p class="hypothesis-note">Тези карти само показват подходящи насоки. Отварянето им не заявява, че това е твоят етап. Ако не си сигурен, <%= link_to "подреди личен план с три въпроса", my_mesto_path %>.</p>
  </section>

  <section class="education-section guide-library-preview">
    <div class="section-heading section-heading--split"><div><p class="eyebrow"><span></span>Конкретният въпрос</p><h2>Продължи към доказателството или понятието</h2></div><p>Отвори отделно обяснение, когато срещнеш документ или дума, която променя решението ти. После можеш да се върнеш по навигационната пътека.</p></div>
    <div class="guide-library-preview__grid">
      <section><header><span>Документи</span><h3>Какво доказва този документ?</h3></header><div><% @documents.each do |document| %><%= link_to education_document_path(document["slug"]) do %><strong><%= document["title"] %></strong><small><%= document["summary"] %></small><% end %><% end %></div><%= link_to "Виж всички документи", education_documents_path, class: "text-link" %></section>
      <section><header><span>Термини</span><h3>Какво означава тази дума?</h3></header><div><% @terms.each do |term| %><%= link_to term_path(term["slug"]) do %><strong><%= term["title"] %></strong><small><%= term["summary"] %></small><% end %><% end %></div><%= link_to "Виж всички термини", terms_path, class: "text-link" %></section>
    </div>
  </section>

  <section class="education-section education-search-block">
    <div><p class="eyebrow"><span></span>Документи и понятия</p><h2>Какво точно означава това?</h2><p>Търси и по естествени варианти като „акт16“, „акт 16“ или „въвеждане в експлоатация“.</p></div>
    <%= form_with url: education_documents_path, method: :get, class: "education-search" do |form| %>
      <%= form.label :q, "Търси документ или термин", class: "form-label" %>
      <div class="education-search__field"><%= mesto_icon("search", css_class: "size-5") %><%= form.search_field :q, placeholder: "Напр. Акт 15, УПИ, тежести…" %><%= form.submit "Търси", class: "button button--ink" %></div>
    <% end %>
    <div class="library-links"><%= link_to "Всички документи", education_documents_path %><%= link_to "Всички термини", terms_path %></div>
  </section>
</div>
