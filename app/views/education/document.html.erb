<% content_for :title, localized_copy("#{@entry['title']}: какво доказва | #{product_name}", "#{@entry['title']}: What It Proves | #{product_name}") %>
<% content_for :description, @entry["summary"] %>

<div class="site-shell education-page article-page">
  <%= render "breadcrumbs", items: [[t("navigation.documents"), education_documents_path], [@entry["title"], nil]] %>
  <header class="article-hero">
    <p class="eyebrow"><span></span><%= localized_copy("Документ", "Document") %> · <%= education_document_category_label(@entry["category"]) %></p>
    <h1><%= @entry["title"] %></h1><p><%= @entry["summary"] %></p>
    <div class="article-hero__limits"><strong><%= localized_copy("Краткият отговор", "The short answer") %></strong><span><%= @entry.dig("sections", "what") %></span></div>
  </header>

  <article class="document-article">
    <section class="document-context" aria-label="<%= localized_copy("Контекст на документа", "Document context") %>">
      <div><span><%= localized_copy("Кога ще ти потрябва?", "When will you need it?") %></span><%= education_prose(@entry.dig("sections", "when")) %></div>
      <div><span><%= localized_copy("Кой го издава или подписва?", "Who issues or signs it?") %></span><%= education_prose(@entry.dig("sections", "who")) %></div>
      <div><span><%= localized_copy("Защо е важен за купувача?", "Why does it matter to the buyer?") %></span><%= education_prose(@entry.dig("sections", "why")) %></div>
    </section>

    <section class="evidence-boundary" aria-labelledby="evidence-boundary-title">
      <header class="article-section-heading"><p class="eyebrow"><span></span><%= localized_copy("Какво доказва документът", "What the document proves") %></p><h2 id="evidence-boundary-title"><%= localized_copy("Какво можеш да установиш от него?", "What can you establish from it?") %></h2><p><%= localized_copy("Всеки документ отговаря на различен въпрос. Рядко един от тях е достатъчен, за да докаже едновременно собствеността, извършените строителни работи и основанието за плащане.", "Each document answers a different question. A single document is rarely enough to prove title, completed construction work and the basis for payment at the same time.") %></p></header>
      <div>
        <article><span class="evidence-mark evidence-mark--yes"><%= mesto_icon("check", css_class: "size-4") %></span><div><h3><%= localized_copy("Какво установява?", "What does it establish?") %></h3><%= education_prose(@entry.dig("sections", "establishes")) %></div></article>
        <article class="evidence-boundary__not"><span class="evidence-mark"><%= mesto_icon("x", css_class: "size-4") %></span><div><h3><%= localized_copy("Какво не установява?", "What does it not establish?") %></h3><%= education_prose(@entry.dig("sections", "not_establish")) %></div></article>
      </div>
    </section>

    <section class="document-reading document-reading--wide" aria-labelledby="document-reading-title">
      <div>
        <p class="eyebrow"><span></span><%= localized_copy("Какво да гледаш в документа", "What to look for in the document") %></p>
        <h2 id="document-reading-title"><%= localized_copy("Кои данни да сравниш?", "Which details should you compare?") %></h2>
        <%= education_prose(@entry.dig("sections", "compare")) %>
      </div>
    </section>

    <section class="document-process">
      <div><span class="section-kicker"><%= localized_copy("Място в процеса", "Place in the process") %></span><h2><%= localized_copy("Какво идва преди и след?", "What comes before and after?") %></h2><%= education_prose(@entry.dig("sections", "before_after")) %></div>
      <aside><span><%= localized_copy("Плащане по договор", "Contract payment") %></span><h3><%= localized_copy("Може ли от него да зависи плащане?", "Can a payment depend on it?") %></h3><%= education_prose(@entry.dig("sections", "payment")) %><p class="scope-note"><%= localized_copy("Провери какво точно изисква клаузата в твоя договор, с кой документ се доказва условието и как трябва да бъдеш уведомен.", "Check exactly what your contract requires, which document proves the condition and how notice must be given.") %></p></aside>
    </section>

    <section class="document-access" aria-labelledby="document-access-title">
      <header><p class="eyebrow"><span></span><%= localized_copy("Откъде идва документът", "Where the document comes from") %></p><h2 id="document-access-title"><%= localized_copy("Намиране и проверка", "Finding and checking it") %></h2></header>
      <div><span><%= localized_copy("Може ли Mesto да го намери?", "Can Mesto find it?") %></span><%= education_prose(@entry.dig("sections", "availability")) %></div>
      <div><span><%= localized_copy("Къде да го провериш или поискаш?", "Where should you check or request it?") %></span><%= education_prose(@entry.dig("sections", "where")) %></div>
    </section>

    <section class="professional-review-note">
      <div><%= mesto_icon("shield", css_class: "size-6") %><span><%= localized_copy("Последна проверка преди решение", "One last check before you decide") %></span></div>
      <div><h2><%= localized_copy("Кога е нужен професионален преглед?", "When do you need a professional review?") %></h2><%= education_prose(@entry.dig("sections", "professional_review")) %></div>
    </section>

    <section class="document-buyer-checks" aria-labelledby="document-buyer-checks-title">
      <div><p class="eyebrow"><span></span><%= localized_copy("Преди да продължиш", "Before you continue") %></p><h2 id="document-buyer-checks-title"><%= localized_copy("Провери тези подробности", "Check these details") %></h2><p><%= localized_copy("Използвай списъка, за да се подготвиш за разговор с продавача или с избрания от теб специалист.", "Use this list to prepare for a conversation with the seller or a specialist you trust.") %></p></div>
      <ol><% Array(@entry.dig("sections", "buyer_checks")).each_with_index do |check, index| %><li><span><%= format("%02d", index + 1) %></span><p><%= check %></p></li><% end %></ol>
    </section>
  </article>

  <% related = (Array(@entry["related_document_keys"]) + Array(@entry["related_term_keys"]) + Array(@entry["related_stage_keys"])).uniq %>
  <% if related.any? %><section class="related-content"><h2><%= localized_copy("Свързани теми", "Related topics") %></h2><div><% related.each do |key| %><% item = @catalog.find(key) %><%= link_to education_path_for(item), target: "_blank", rel: "noopener noreferrer" do %><span><%= item["kind"] == "stage" ? localized_copy("Етап", "Stage") : item["kind"] == "term" ? localized_copy("Термин", "Term") : localized_copy("Документ", "Document") %></span><strong><%= item["title"] %></strong><% end %><% end %></div></section><% end %>

  <% if current_buyer_journey %><div class="lesson-action"><div><strong><%= localized_copy("Добави към прочетените теми", "Add to completed topics") %></strong><p><%= localized_copy("Това отбелязва само, че си прочел обяснението. Не означава, че документът е намерен или проверен.", "This only records that you have read the explanation. It does not mean the document has been found or checked.") %></p></div><%= button_to localized_copy("Отбележи като прочетено", "Mark as read"), buyer_journey_progress_path, method: :patch, params: { item_kind: "lesson", item_key: @entry["key"], status: "done", content_version: @entry["content_version"] }, class: "button button--secondary" %></div><% end %>
  <%= render "sources", entry: @entry, catalog: @catalog %>
</div>
