<% page_title = content_for(:title).presence || product_name %>
<% page_description = content_for(:description).presence || t("layout.meta_description") %>
<% canonical_origin = Rails.env.production? ? "https://#{Rails.application.config.x.app_host}" : request.base_url %>
<% canonical_url = "#{canonical_origin}#{request.path}" %>
<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= page_description %>">
    <meta name="theme-color" content="#f4f0e8">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="<%= product_name %>">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:url" content="<%= canonical_url %>">
    <meta property="og:locale" content="<%= I18n.locale == :bg ? 'bg_BG' : 'en_US' %>">
    <meta name="twitter:card" content="summary">
    <link rel="canonical" href="<%= canonical_url %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= product_name %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Literata:opsz,wght@7..72,500;7..72,600&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header class="site-header">
      <div class="site-shell site-header__inner">
        <%= link_to root_path, class: "brand", aria: { label: t("navigation.home") } do %>
          <span class="brand__mark" aria-hidden="true">
            <svg viewBox="0 0 40 40" fill="none"><path d="M8 29V15l12-7 12 7v14"/><path d="M13 29V18l7-4 7 4v11M5 29h30"/><path d="M17 29v-7h6v7"/></svg>
          </span>
          <span class="brand__word"><%= product_name %><span class="brand__dot">.</span></span>
        <% end %>

        <nav class="site-nav" aria-label="<%= t('navigation.primary') %>">
          <%= link_to t("navigation.how_it_works"), root_path(anchor: "how-it-works") %>
          <%= link_to t("navigation.guides"), guides_path %>
          <%= link_to t("navigation.documents"), documents_path %>
          <%= link_to t("navigation.glossary"), glossary_path %>
        </nav>

        <div class="site-actions">
          <div class="locale-switch" aria-label="<%= t('navigation.language') %>">
            <%= link_to t("navigation.language_bg"), url_for(locale: :bg), class: (I18n.locale == :bg ? "is-active" : nil), aria: { current: (I18n.locale == :bg ? "page" : nil) } %>
            <%= link_to t("navigation.language_en"), url_for(locale: :en), class: (I18n.locale == :en ? "is-active" : nil), aria: { current: (I18n.locale == :en ? "page" : nil) } %>
          </div>
          <%= link_to root_path(anchor: "property-check"), class: "button button--small button--ink site-actions__cta" do %>
            <%= t("navigation.check_property") %>
            <%= mesto_icon("arrow-right", css_class: "size-4") %>
          <% end %>
        </div>
      </div>
    </header>

    <% if notice || alert %>
      <div class="site-shell flash-wrap">
        <div class="flash <%= alert ? 'flash--alert' : 'flash--notice' %>"><%= alert || notice %></div>
      </div>
    <% end %>

    <main><%= yield %></main>

    <footer class="site-footer">
      <div class="site-shell">
        <div class="site-footer__top">
          <div class="site-footer__brand">
            <%= link_to root_path, class: "brand brand--footer" do %>
              <span class="brand__mark" aria-hidden="true"><svg viewBox="0 0 40 40" fill="none"><path d="M8 29V15l12-7 12 7v14"/><path d="M13 29V18l7-4 7 4v11M5 29h30"/><path d="M17 29v-7h6v7"/></svg></span>
              <span class="brand__word"><%= product_name %><span class="brand__dot">.</span></span>
            <% end %>
            <p><%= t("layout.footer_intro") %></p>
          </div>
          <div class="site-footer__links">
            <div>
              <p class="site-footer__label"><%= t("layout.footer_product") %></p>
              <%= link_to t("navigation.check_property"), root_path(anchor: "property-check") %>
              <%= link_to t("navigation.how_it_works"), root_path(anchor: "how-it-works") %>
            </div>
            <div>
              <p class="site-footer__label"><%= t("layout.footer_knowledge") %></p>
              <%= link_to t("navigation.guides"), guides_path %>
              <%= link_to t("navigation.documents"), documents_path %>
              <%= link_to t("navigation.glossary"), glossary_path %>
            </div>
          </div>
        </div>
        <div class="site-footer__bottom">
          <p>© <%= Time.current.year %> <%= product_name %> · <%= t("layout.footer") %></p>
          <p><%= t("reports.disclaimer", product_name:) %></p>
        </div>
      </div>
    </footer>
  </body>
</html>
