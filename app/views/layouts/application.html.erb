<% page_title = content_for(:title).presence || product_name %>
<% page_description = content_for(:description).presence || t("layout.meta_description") %>
<% canonical_url = localized_page_url(I18n.locale) %>
<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= page_description %>">
    <meta name="theme-color" content="#f4f0e8">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="<%= product_name %>">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:url" content="<%= canonical_url %>">
    <meta property="og:locale" content="<%= I18n.locale == :bg ? 'bg_BG' : 'en_US' %>">
    <meta property="og:locale:alternate" content="<%= I18n.locale == :bg ? 'en_US' : 'bg_BG' %>">
    <meta name="twitter:card" content="summary">
    <link rel="canonical" href="<%= canonical_url %>">
    <link rel="alternate" hreflang="bg" href="<%= localized_page_url(:bg) %>">
    <link rel="alternate" hreflang="en" href="<%= localized_page_url(:en) %>">
    <link rel="alternate" hreflang="x-default" href="<%= localized_page_url(:bg) %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= product_name %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <% if controller_name == "home" && action_name == "show" %>
      <script type="application/ld+json"><%= raw json_escape({ "@context": "https://schema.org", "@type": "WebSite", name: product_name, alternateName: "Mesto.bg", url: localized_page_url(:bg), inLanguage: %w[bg en] }.to_json) %></script>
    <% end %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Literata:opsz,wght@7..72,500;7..72,600&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16">
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
    <link rel="manifest" href="<%= pwa_manifest_path %>">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header class="site-header">
      <div class="site-shell site-header__inner">
        <%= link_to root_path, class: "brand", aria: { label: t("navigation.home") } do %>
          <%= mesto_wordmark(variant: :accent, theme: :light, animate: current_page?(root_path), css_class: "brand__wordmark", title: product_name) %>
        <% end %>

        <nav class="site-nav" aria-label="<%= t('navigation.primary') %>">
          <%= link_to t("navigation.guides"), guide_path %>
          <%= link_to t("navigation.calculator"), purchase_calculator_path %>
          <%= link_to t("navigation.documents"), education_documents_path %>
          <%= link_to t("navigation.glossary"), terms_path %>
        </nav>

        <div class="site-actions">
          <div class="locale-switch" aria-label="<%= t('navigation.language') %>">
            <%= link_to t("navigation.language_bg"), localized_page_path(:bg), class: (I18n.locale == :bg ? "is-active" : nil), aria: { current: (I18n.locale == :bg ? "page" : nil) } %>
            <%= link_to t("navigation.language_en"), localized_page_path(:en), class: (I18n.locale == :en ? "is-active" : nil), aria: { current: (I18n.locale == :en ? "page" : nil) } %>
          </div>
          <details class="mobile-nav">
            <summary><%= t("navigation.menu") %></summary>
            <div>
              <%= link_to t("navigation.check_property"), root_path(anchor: "property-check") %>
              <%= link_to t("navigation.guides"), guide_path %>
              <%= link_to t("navigation.calculator"), purchase_calculator_path %>
              <%= link_to t("navigation.documents"), education_documents_path %>
              <%= link_to t("navigation.glossary"), terms_path %>
              <% if current_buyer_journey %><%= link_to t("navigation.my_mesto"), my_mesto_path %><% end %>
            </div>
          </details>
          <%= link_to root_path(anchor: "property-check"), class: "button button--small button--secondary site-actions__cta" do %>
            <%= t("navigation.check_property") %>
            <%= mesto_icon("arrow-right", css_class: "size-4") %>
          <% end %>
        </div>
      </div>
    </header>

    <% if notice || alert %>
      <div class="site-shell flash-wrap">
        <div class="flash <%= alert ? 'flash--alert' : 'flash--notice' %>"><%= alert || notice %></div>
      </div>
    <% end %>

    <main><%= yield %></main>

    <footer class="site-footer">
      <div class="site-shell">
        <div class="site-footer__top">
          <div class="site-footer__brand">
            <%= link_to root_path, class: "brand brand--footer" do %>
              <%= mesto_wordmark(variant: :monochrome, theme: :dark, css_class: "brand__wordmark", title: product_name) %>
            <% end %>
            <p><%= t("layout.footer_intro") %></p>
          </div>
          <div class="site-footer__links">
            <div>
              <p class="site-footer__label"><%= t("layout.footer_product") %></p>
              <%= link_to t("navigation.check_property"), root_path(anchor: "property-check") %>
              <%= link_to t("navigation.how_it_works"), root_path(anchor: "how-it-works") %>
              <%= link_to t("navigation.purchase_calculator"), purchase_calculator_path %>
              <%= link_to t("navigation.mortgage_calculator"), mortgage_calculator_path %>
            </div>
            <div>
              <p class="site-footer__label"><%= t("layout.footer_knowledge") %></p>
              <%= link_to t("navigation.guides"), guide_path %>
              <%= link_to t("navigation.documents"), education_documents_path %>
              <%= link_to t("navigation.glossary"), terms_path %>
              <%= link_to t("navigation.my_mesto"), my_mesto_path %>
            </div>
            <div>
              <p class="site-footer__label"><%= localized_copy("Данни", "Data") %></p>
              <%= link_to localized_copy("Източници и методология", "Sources and methodology"), data_sources_policy_path %>
              <%= link_to localized_copy("Поверителност", "Privacy"), privacy_policy_path %>
              <%= link_to localized_copy("Бисквитки", "Cookies"), cookie_policy_path %>
            </div>
            <div>
              <p class="site-footer__label"><%= localized_copy("Правна информация", "Legal") %></p>
              <%= link_to localized_copy("За оператора", "Operator information"), legal_notice_path %>
              <%= link_to localized_copy("Общи условия", "Terms of use"), terms_of_use_path %>
            </div>
          </div>
        </div>
        <div class="site-footer__bottom">
          <p>© <%= Time.current.year %> <%= product_name %> · <%= legal_entity_name %>, <%= localized_copy("ЕИК", "UIC") %> <%= legal_entity_eik %></p>
          <p><%= t("reports.disclaimer", product_name:) %></p>
        </div>
      </div>
    </footer>
  </body>
</html>
