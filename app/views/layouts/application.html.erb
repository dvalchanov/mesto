<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || product_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= product_name %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen bg-[#f6f7f4] text-slate-950 antialiased selection:bg-emerald-200">
    <header class="border-b border-slate-200/80 bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 sm:px-8">
        <%= link_to root_path, class: "group flex items-center gap-3" do %>
          <span class="grid size-9 place-items-center rounded-xl bg-emerald-950 text-sm font-bold text-emerald-100"><%= product_name.first %></span>
          <span>
            <span class="block text-sm font-bold tracking-tight"><%= product_name %></span>
            <span class="block text-[10px] font-semibold uppercase tracking-[0.16em] text-slate-500"><%= t("layout.product_tagline") %></span>
          </span>
        <% end %>
        <nav class="flex items-center gap-2 text-sm font-semibold">
          <%= link_to t("navigation.language_bg"), url_for(locale: :bg), class: "rounded-lg px-2.5 py-1.5 #{I18n.locale == :bg ? 'bg-slate-900 text-white' : 'text-slate-500 hover:bg-slate-100'}" %>
          <%= link_to t("navigation.language_en"), url_for(locale: :en), class: "rounded-lg px-2.5 py-1.5 #{I18n.locale == :en ? 'bg-slate-900 text-white' : 'text-slate-500 hover:bg-slate-100'}" %>
        </nav>
      </div>
    </header>

    <% if notice || alert %>
      <div class="mx-auto max-w-7xl px-5 pt-5 sm:px-8">
        <div class="rounded-xl border px-4 py-3 text-sm font-medium <%= alert ? 'border-amber-200 bg-amber-50 text-amber-900' : 'border-emerald-200 bg-emerald-50 text-emerald-900' %>"><%= alert || notice %></div>
      </div>
    <% end %>

    <main><%= yield %></main>

    <footer class="border-t border-slate-200 bg-white">
      <div class="mx-auto flex max-w-7xl flex-col gap-2 px-5 py-8 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between sm:px-8">
        <p><%= product_name %> · <%= t("layout.footer") %></p>
        <p><%= t("reports.disclaimer", product_name:) %></p>
      </div>
    </footer>
  </body>
</html>
