<% content_for :title, t("home.meta_title", product_name:) %>
<% content_for :description, t("home.meta_description", product_name:) %>
<% content_for :head do %><link href="https://cdn.jsdelivr.net/npm/maplibre-gl@6.4.1/dist/maplibre-gl.css" rel="stylesheet"><% end %>

<section class="home-hero" id="property-check">
  <div class="home-hero__topography" aria-hidden="true">
    <svg viewBox="0 0 760 640" fill="none">
      <path d="M760 52C650 50 588 105 500 110c-105 6-170-50-265-19C144 120 70 180 61 256c-11 92 61 127 127 173 64 45 88 129 149 211"/>
      <path d="M760 125c-95-4-158 40-235 46-90 7-150-45-231-22-79 23-147 74-154 137-8 73 49 100 104 138 56 39 79 124 135 216"/>
      <path d="M760 200c-78-6-132 26-198 35-76 11-127-36-197-18-68 17-125 55-132 103-8 58 38 79 83 111 45 31 64 117 109 209"/>
      <path d="M760 278c-62-9-107 15-160 27-60 13-103-27-159-13-55 13-101 42-107 77-7 44 29 59 65 85 36 26 50 100 86 186"/>
    </svg>
  </div>
  <div class="site-shell home-hero__grid">
    <div class="home-hero__copy">
      <p class="eyebrow"><span></span><%= t("home.eyebrow") %></p>
      <h1><%= t("home.headline_html").html_safe %></h1>
      <p class="home-hero__lead"><%= t("home.supporting_copy") %></p>
      <div class="home-hero__proof">
        <span class="proof-avatars" aria-hidden="true"><i><%= localized_copy("АГ", "AG") %></i><i><%= localized_copy("СО", "CO") %></i><i><%= localized_copy("НГ", "NG") %></i></span>
        <p><strong><%= t("home.source_count") %></strong><br><%= t("home.source_note") %></p>
      </div>
    </div>

    <% search_mode = @identifier_error || params[:search] == "identifier" ? "identifier" : "address" %>
    <div class="search-panel" data-controller="property-search-tabs" data-property-search-tabs-active-value="<%= search_mode %>">
      <div class="search-panel__heading">
        <span class="search-panel__icon"><%= mesto_icon("search", css_class: "size-5") %></span>
        <div>
          <p><%= t("home.search.card_eyebrow") %></p>
          <h2><%= t("home.search.card_title") %></h2>
        </div>
      </div>
      <nav class="search-panel__tabs" aria-label="<%= t('home.search.methods_label') %>" role="tablist">
        <%= link_to t("home.search.by_address"), root_path, id: "search-tab-address", class: (search_mode == "address" ? "is-active" : nil), role: "tab", aria: { controls: "search-panel-address", selected: search_mode == "address" }, tabindex: (search_mode == "address" ? 0 : -1), data: { property_search_tabs_target: "tab", search_mode: "address", action: "click->property-search-tabs#activate keydown->property-search-tabs#navigate" } %>
        <%= link_to t("home.search.by_identifier"), root_path(search: "identifier"), id: "search-tab-identifier", class: (search_mode == "identifier" ? "is-active" : nil), role: "tab", aria: { controls: "search-panel-identifier", selected: search_mode == "identifier" }, tabindex: (search_mode == "identifier" ? 0 : -1), data: { property_search_tabs_target: "tab", search_mode: "identifier", action: "click->property-search-tabs#activate keydown->property-search-tabs#navigate" } %>
      </nav>
      <div id="search-panel-address"
           role="tabpanel"
           aria-labelledby="search-tab-address"
           data-property-search-tabs-target="panel"
           data-search-mode="address"
           data-controller="property-locator"
           data-property-locator-suggestions-url-value="<%= property_address_suggestions_path %>"
           data-property-locator-buildings-url-value="<%= property_finder_buildings_path %>"
           data-property-locator-style-url-value="<%= Rails.application.config.x.map_style_url %>"
           data-property-locator-copy-value="<%= {
             selected: t('property_finder.locator.selected'),
             zoom: t('property_finder.locator.zoom'),
             loading: t('property_finder.locator.loading'),
             noResults: t('property_finder.locator.no_results'),
             results: t('property_finder.locator.results', count: '%{count}'),
             truncated: t('property_finder.locator.truncated'),
             error: t('property_finder.locator.error'),
             unknownAddress: t('property_finder.locator.unknown_address'),
             choose: t('property_finder.locator.choose')
           }.to_json %>"
           <%= "hidden" unless search_mode == "address" %>>
        <%= form_with url: property_finder_path, method: :get, class: "property-search", data: { property_locator_target: "form" } do |form| %>
          <div>
            <%= form.label :address, t("home.search.address_label"), class: "form-label" %>
            <div class="property-locator__input">
              <div class="property-search__field property-search__field--address">
                <%= mesto_icon("map-pin", css_class: "size-5") %>
                <%= form.search_field :address,
                      maxlength: PropertyFinder::AddressSearch::MAX_QUERY_LENGTH,
                      required: true,
                      autocomplete: "off",
                      placeholder: t("home.search.address_placeholder"),
                      role: "combobox",
                      aria: { describedby: "address-hint", autocomplete: "list", expanded: false, controls: "home-address-suggestions" },
                      data: { property_locator_target: "addressInput", action: "input->property-locator#suggest focus->property-locator#refreshSuggestions keydown->property-locator#navigateSuggestions" } %>
              </div>
              <div id="home-address-suggestions" class="property-locator__suggestions" role="listbox" data-property-locator-target="suggestions" hidden></div>
            </div>
            <%= form.hidden_field :building_identifier, data: { property_locator_target: "buildingInput" } %>
            <%= form.hidden_field :locator_method, value: "address", data: { property_locator_target: "methodInput" } %>
            <p class="property-locator__selection" data-property-locator-target="selection" hidden></p>
          </div>
          <div class="property-search__actions">
            <%= form.button class: "button button--primary" do %>
              <span><%= t("home.search.address_submit") %></span>
              <%= mesto_icon("arrow-right", css_class: "size-5") %>
            <% end %>
            <button type="button" class="button button--outline" data-action="property-locator#openMap">
              <%= t("property_finder.locator.open_map") %><%= mesto_icon("map-pin", css_class: "size-4") %>
            </button>
          </div>
        <% end %>
        <%= render "property_finder/map_dialog" %>
        <div class="search-panel__hint" id="address-hint">
          <%= mesto_icon("building", css_class: "size-4") %>
          <p><strong><%= t("home.search.address_hint_title") %></strong> <%= t("home.search.address_hint") %></p>
        </div>
      </div>
      <div id="search-panel-identifier" role="tabpanel" aria-labelledby="search-tab-identifier" data-property-search-tabs-target="panel" data-search-mode="identifier" <%= "hidden" unless search_mode == "identifier" %>>
        <%= form_with url: property_analyses_path, method: :post, class: "property-search" do |form| %>
          <div>
            <%= form.label :cadastral_identifier, t("home.search.label"), class: "form-label" %>
            <div class="property-search__field <%= 'has-error' if @identifier_error %>">
              <%= mesto_icon("map-pin", css_class: "size-5") %>
              <%= form.text_field :cadastral_identifier, value: @identifier_value, maxlength: 100, required: true, placeholder: t("home.search.placeholder"), aria: { describedby: (@identifier_error ? "identifier-error" : "identifier-hint") } %>
            </div>
            <% if @identifier_error %><p id="identifier-error" class="form-error"><%= @identifier_error %></p><% end %>
          </div>
          <%= form.button class: "button button--primary button--wide" do %>
            <span><%= t("home.search.submit") %></span>
            <%= mesto_icon("arrow-right", css_class: "size-5") %>
          <% end %>
        <% end %>
        <div class="search-panel__hint" id="identifier-hint">
          <%= mesto_icon("document", css_class: "size-4") %>
          <p><strong><%= t("home.search.hint_title") %></strong> <%= t("home.search.hint") %></p>
        </div>
      </div>
      <div class="search-panel__trust">
        <span><%= mesto_icon("shield", css_class: "size-4") %> <%= t("home.search.private") %></span>
        <span><%= mesto_icon("check", css_class: "size-4") %> <%= t("home.search.no_registration") %></span>
      </div>
    </div>
  </div>
  <div class="site-shell home-hero__footnote">
    <span><%= t("home.coverage_label") %></span>
    <div></div>
    <p><%= t("home.coverage_value") %></p>
  </div>
</section>

<section class="home-section home-film" aria-labelledby="home-film-title">
  <div class="site-shell">
    <div class="section-heading section-heading--split">
      <div>
        <p class="eyebrow"><span></span><%= t("home.film.eyebrow") %></p>
        <h2 id="home-film-title"><%= t("home.film.title") %></h2>
      </div>
      <p><%= t("home.film.description") %></p>
    </div>
    <%# Bulgarian uses the "dark to clear" cut; English keeps the original until its cut is rendered. %>
    <% film = I18n.locale == :en ? "mesto-explainer-en" : "mesto-explainer-story-bg" %>
    <figure class="home-film__frame<%= " home-film__frame--dusk" if film.include?("story") %>"
            data-controller="explainer-video"
            data-explainer-video-play-label-value="<%= t('home.film.play') %>"
            data-explainer-video-pause-label-value="<%= t('home.film.pause') %>">
      <video muted loop playsinline preload="none"
             poster="<%= asset_path("#{film}-poster.jpg") %>"
             aria-describedby="home-film-summary"
             data-explainer-video-target="video"
             data-action="play->explainer-video#render pause->explainer-video#render">
        <source src="<%= asset_path("#{film}.webm") %>" type="video/webm">
        <source src="<%= asset_path("#{film}.mp4") %>" type="video/mp4">
      </video>
      <button type="button" class="home-film__toggle" aria-label="<%= t('home.film.play') %>" data-state="paused" data-explainer-video-target="toggle" data-action="explainer-video#toggle">
        <svg class="home-film__play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5L8 5.5Z"/></svg>
        <svg class="home-film__pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5h3v14H8zM13 5h3v14h-3z"/></svg>
      </button>
      <figcaption id="home-film-summary" class="sr-only"><%= t("home.film.summary") %></figcaption>
    </figure>
  </div>
</section>

<section class="home-section home-section--paper">
  <div class="site-shell">
    <div class="section-heading section-heading--split">
      <div>
        <p class="eyebrow"><span></span><%= t("home.discover.eyebrow") %></p>
        <h2><%= t("home.discover.title") %></h2>
      </div>
      <p><%= t("home.discover.description") %></p>
    </div>

    <div class="discover-grid">
      <% [
        ["building", "identity", "discover-card--large"],
        ["layers", "planning", ""],
        ["route", "activity", ""],
        ["tree", "surroundings", "discover-card--wide"]
      ].each_with_index do |(icon, key, css), index| %>
        <article class="discover-card <%= css %>">
          <div class="discover-card__number">0<%= index + 1 %></div>
          <span class="discover-card__icon"><%= mesto_icon(icon, css_class: "size-6") %></span>
          <h3><%= t("home.discover.#{key}.title") %></h3>
          <p><%= t("home.discover.#{key}.text") %></p>
          <% if key == "identity" %>
            <div class="parcel-sketch" aria-hidden="true">
              <svg viewBox="0 0 360 150"><path d="m22 102 48-65 83 14 49-24 128 43-41 55-96-17-57 25-114-31Z"/><path d="m70 37 66 96M153 51l40 57M202 27l-9 81M289 125l-87-98"/><circle cx="193" cy="108" r="5"/></svg>
            </div>
          <% elsif key == "surroundings" %>
            <div class="distance-chips">
              <span><b>450 m</b><%= t("home.discover.surroundings.metro") %></span>
              <span><b>3</b><%= t("home.discover.surroundings.schools") %></span>
              <span><b>8 min</b><%= t("home.discover.surroundings.park") %></span>
            </div>
          <% end %>
        </article>
      <% end %>
    </div>
  </div>
</section>

<section class="home-section method-section" id="how-it-works">
  <div class="site-shell method-grid">
    <div class="method-intro">
      <p class="eyebrow eyebrow--light"><span></span><%= t("home.method.eyebrow") %></p>
      <h2><%= t("home.method.title") %></h2>
      <p><%= t("home.method.description") %></p>
      <div class="method-quote">
        <span>“</span>
        <blockquote><%= t("home.method.quote") %></blockquote>
      </div>
    </div>
    <ol class="method-steps">
      <% %w[identifier sources analysis report].each_with_index do |key, index| %>
        <li>
          <span class="method-steps__number"><%= index + 1 %></span>
          <div><h3><%= t("home.method.steps.#{key}.title") %></h3><p><%= t("home.method.steps.#{key}.text") %></p></div>
        </li>
      <% end %>
    </ol>
  </div>
  <div class="site-shell source-strip">
    <p><%= t("home.method.sources_label") %></p>
    <div><span><%= localized_copy("АГКК", "AGCC") %></span><span><%= localized_copy("НАГ", "NAG") %></span><span><%= localized_copy("Софияплан", "SofiaPlan") %></span><span><%= localized_copy("Столична община", "Sofia Municipality") %></span></div>
  </div>
</section>

<section class="home-section knowledge-preview">
  <div class="site-shell">
    <div class="section-heading section-heading--split">
      <div>
        <p class="eyebrow"><span></span><%= t("home.knowledge.eyebrow") %></p>
        <h2><%= t("home.knowledge.title") %></h2>
      </div>
      <%= link_to guide_path, class: "text-link" do %><%= t("home.knowledge.view_all") %><%= mesto_icon("arrow-up-right", css_class: "size-4") %><% end %>
    </div>
    <div class="article-grid">
      <% [[guide_path, "guide", "01"], [education_documents_path, "documents", "02"], [terms_path, "glossary", "03"]].each do |path, key, number| %>
        <%= link_to path, class: "article-card" do %>
          <span class="article-card__number"><%= number %></span>
          <span class="article-card__tag"><%= t("home.knowledge.#{key}.tag") %></span>
          <h3><%= t("home.knowledge.#{key}.title") %></h3>
          <p><%= t("home.knowledge.#{key}.text") %></p>
          <span class="article-card__link"><%= t("home.knowledge.read") %><%= mesto_icon("arrow-right", css_class: "size-4") %></span>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<section class="home-cta">
  <div class="site-shell home-cta__inner">
    <div>
      <p class="eyebrow eyebrow--light"><span></span><%= t("home.final_cta.eyebrow") %></p>
      <h2><%= t("home.final_cta.title") %></h2>
      <p><%= t("home.final_cta.text") %></p>
    </div>
    <%= link_to root_path(anchor: "property-check"), class: "button button--subtle" do %>
      <%= t("home.final_cta.button") %><%= mesto_icon("arrow-right", css_class: "size-5") %>
    <% end %>
  </div>
</section>
