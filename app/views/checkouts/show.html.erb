<% content_for :title, "#{t('checkout.processing_title')} — #{product_name}" %>
<section class="mx-auto max-w-2xl px-5 py-16 sm:px-8">
  <div class="rounded-[2rem] border border-slate-200 bg-white p-7 text-center shadow-xl shadow-slate-900/5 sm:p-10">
    <% if @outcome %>
      <span class="mx-auto grid size-14 place-items-center rounded-full bg-rose-100 text-xl font-black text-rose-700">!</span>
      <h1 class="mt-5 text-2xl font-bold"><%= t("checkout.#{@outcome}") %></h1>
      <%= link_to t("checkout.try_again"), report_checkout_path(@analysis), class: "mt-7 inline-flex rounded-xl bg-slate-950 px-5 py-3 text-sm font-bold text-white" %>
    <% elsif @order.status == "paid" %>
      <h1 class="text-2xl font-bold"><%= t("checkout.success_title") %></h1>
      <%= link_to t("checkout.back_to_report"), report_path(@analysis), class: "mt-7 inline-flex rounded-xl bg-emerald-950 px-5 py-3 text-sm font-bold text-white" %>
    <% else %>
      <span class="mx-auto grid size-14 place-items-center rounded-full bg-amber-100 text-xl font-black text-amber-700">€</span>
      <h1 class="mt-5 text-2xl font-bold"><%= t("checkout.processing_title") %></h1>
      <p class="mx-auto mt-3 max-w-lg leading-7 text-slate-600"><%= t("checkout.processing_body") %></p>
      <% if Rails.application.config.x.fake_payments_enabled %>
        <div class="mt-8 space-y-3"><%= button_to t("checkout.success_action"), fake_checkout_succeed_path(@order), method: :post, class: "w-full rounded-xl bg-emerald-950 px-5 py-4 text-sm font-black text-white hover:bg-emerald-800" %><div class="grid gap-3 sm:grid-cols-2"><%= button_to t("checkout.fail_action"), fake_checkout_fail_path(@order), method: :post, class: "w-full rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-bold text-rose-800" %><%= button_to t("checkout.cancel_action"), fake_checkout_cancel_path(@order), method: :post, class: "w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700" %></div></div>
      <% end %>
    <% end %>
  </div>
</section>
