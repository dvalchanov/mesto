<% content_for :title, "#{t('checkout.success_title')} — #{product_name}" %>
<section class="mx-auto max-w-2xl px-5 py-16 text-center sm:px-8">
  <div class="rounded-[2rem] border border-emerald-200 bg-white p-8 shadow-xl shadow-emerald-950/5 sm:p-12">
    <span class="mx-auto grid size-16 place-items-center rounded-full bg-emerald-100 text-2xl font-black text-emerald-700">✓</span>
    <h1 class="mt-6 text-3xl font-bold tracking-tight"><%= t("checkout.success_title") %></h1>
    <p class="mx-auto mt-4 max-w-lg leading-7 text-slate-600"><%= t("checkout.success_body") %></p>
    <%= link_to t("checkout.back_to_report"), report_path(@analysis), class: "mt-8 inline-flex rounded-xl bg-emerald-950 px-6 py-3.5 text-sm font-black text-white hover:bg-emerald-800" %>
  </div>
</section>
