<% content_for :title, "#{t('checkout.success_title')} — #{product_name}" %>
<section class="site-shell checkout-page">
  <div class="checkout-state">
    <span class="checkout-state__icon"><%= mesto_icon("check", css_class: "size-8") %></span>
    <p class="eyebrow mt-6 justify-center"><span></span><%= t("payments.products.full_property_report.name") %><span></span></p>
    <h1><%= t("checkout.success_title") %></h1>
    <p><%= t("checkout.success_body") %></p>
    <%= link_to report_path(@analysis), class: "button button--ink mt-8" do %><%= t("checkout.back_to_report") %><%= mesto_icon("arrow-right", css_class: "size-4") %><% end %>
  </div>
</section>
