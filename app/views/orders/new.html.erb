<% content_for :title, "#{t('checkout.title')} — #{product_name}" %>
<section class="site-shell checkout-page">
  <%= link_to report_path(@analysis), class: "checkout-back" do %>← <%= t("common.back") %><% end %>
  <div class="checkout-shell">
    <div class="checkout-main">
      <p class="eyebrow"><span></span><%= t("payments.products.full_property_report.name") %></p>
      <h1><%= t("checkout.title") %></h1>
      <p class="checkout-id"><%= t("checkout.subtitle", identifier: @analysis.submitted_identifier) %></p>
      <div class="checkout-banner"><%= mesto_icon("shield", css_class: "size-5") %><span><%= t("checkout.fake_banner") %></span></div>
      <%= form_with model: @order, url: report_orders_path(@analysis), class: "checkout-form" do |form| %>
        <div>
          <%= form.label :email, t("checkout.email"), class: "form-label" %>
          <%= form.email_field :email, required: true, autocomplete: "email", placeholder: t("checkout.email_placeholder") %>
          <% if @order.errors.any? %><p class="form-error"><%= t("checkout.invalid_email") %></p><% end %>
        </div>
        <%= form.button class: "button button--primary button--wide" do %>
          <%= mesto_icon("lock", css_class: "size-4") %><%= t("checkout.submit") %><%= mesto_icon("arrow-right", css_class: "size-4") %>
        <% end %>
      <% end %>
    </div>
    <aside class="checkout-aside">
      <p class="checkout-aside__label"><%= t("checkout.includes_title") %></p>
      <h2><%= t("checkout.includes") %></h2>
      <ul>
        <% %w[timeline planning nearby evidence].each do |item| %>
          <li><%= mesto_icon("check", css_class: "size-4") %><%= t("reports.locked.previews.#{item}") %></li>
        <% end %>
      </ul>
      <div class="checkout-total">
        <div><span><%= t("checkout.product") %></span><span><%= t(@product.fetch(:name_key)) %></span></div>
        <div><span><%= t("checkout.amount") %></span><strong><%= formatted_price(@product.fetch(:amount_cents), @product.fetch(:currency)) %></strong></div>
      </div>
    </aside>
  </div>
</section>
