<% content_for :title, "#{t('checkout.title')} - #{product_name}" %>
<% content_for :description, localized_copy("Защитено плащане за отключване на пълния личен отчет в Mesto.", "Secure checkout to unlock your full private Mesto report.") %>
<% content_for :head do %><meta name="robots" content="noindex,nofollow"><% end %>
<section class="site-shell checkout-page">
  <%= link_to report_path(public_token: @analysis), class: "checkout-back" do %>← <%= t("common.back") %><% end %>
  <div class="checkout-shell">
    <div class="checkout-main">
      <p class="eyebrow"><span></span><%= t("payments.products.full_property_report.name") %></p>
      <h1><%= t("checkout.title") %></h1>
      <p class="checkout-id"><%= t("checkout.subtitle", identifier: @analysis.submitted_identifier) %></p>
      <div class="checkout-banner"><%= mesto_icon("shield", css_class: "size-5") %><span><%= t("checkout.fake_banner") %></span></div>
      <%= form_with model: @order, url: report_orders_path(public_token: @analysis), class: "checkout-form" do |form| %>
        <div>
          <%= form.label :email, t("checkout.email"), class: "form-label" %>
          <%= form.email_field :email, required: true, autocomplete: "email", placeholder: t("checkout.email_placeholder") %>
          <% if @order.errors[:email].any? %><p class="form-error"><%= t("checkout.invalid_email") %></p><% end %>
        </div>
        <label class="checkout-consent">
          <%= check_box_tag "order[accept_terms]", "1", params.dig(:order, :accept_terms) == "1", required: true %>
          <span><%= localized_copy("Приемам", "I accept the") %> <%= link_to localized_copy("Общите условия", "Terms of use"), terms_of_use_path, target: "_blank", rel: "noopener" %> <%= localized_copy("и потвърждавам, че прочетох", "and confirm that I have read the") %> <%= link_to localized_copy("Политиката за поверителност", "Privacy notice"), privacy_policy_path, target: "_blank", rel: "noopener" %>.</span>
        </label>
        <label class="checkout-consent">
          <%= check_box_tag "order[accept_immediate_delivery]", "1", params.dig(:order, :accept_immediate_delivery) == "1", required: true %>
          <span><%= localized_copy("Изрично искам изпълнението и доставката на цифровия отчет да започнат веднага и потвърждавам, че след пълното му отключване губя 14-дневното право на отказ.", "I expressly request immediate performance and delivery of the digital report and acknowledge that, once it is fully unlocked, I lose the 14-day withdrawal right.") %> <%= link_to localized_copy("Повече информация", "Learn more"), terms_of_use_path(anchor: "withdrawal"), target: "_blank", rel: "noopener" %>.</span>
        </label>
        <% @order.errors[:base].each do |message| %><p class="form-error"><%= message %></p><% end %>
        <%= form.button class: "button button--primary button--wide" do %>
          <%= mesto_icon("lock", css_class: "size-4") %><%= t("checkout.submit") %><%= mesto_icon("arrow-right", css_class: "size-4") %>
        <% end %>
      <% end %>
    </div>
    <aside class="checkout-aside">
      <p class="checkout-aside__label"><%= t("checkout.includes_title") %></p>
      <h2><%= t("checkout.includes") %></h2>
      <ul>
        <% %w[timeline planning nearby evidence].each do |item| %>
          <li><%= mesto_icon("check", css_class: "size-4") %><%= t("reports.locked.previews.#{item}") %></li>
        <% end %>
      </ul>
      <div class="checkout-total">
        <div><span><%= t("checkout.product") %></span><span><%= t(@product.fetch(:name_key)) %></span></div>
        <div><span><%= t("checkout.amount") %></span><strong><%= formatted_price(@product.fetch(:amount_cents), @product.fetch(:currency)) %></strong></div>
      </div>
      <p class="checkout-legal-note"><%= localized_copy("Продуктът е цифрово съдържание за конкретния имот. Крайната цена е показана по-горе; не се добавят непоказани такси.", "The product is digital content for the specific property. The total price is shown above; no undisclosed charges are added.") %></p>
    </aside>
  </div>
</section>
