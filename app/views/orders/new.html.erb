<% content_for :title, "#{t('checkout.title')} — #{product_name}" %>
<section class="mx-auto max-w-5xl px-5 py-12 sm:px-8 sm:py-16">
  <%= link_to "← #{t('common.back')}", report_path(@analysis), class: "text-sm font-bold text-slate-600 hover:text-slate-950" %>
  <div class="mt-6 grid overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-xl shadow-slate-900/5 lg:grid-cols-[1fr_.85fr]">
    <div class="p-7 sm:p-10">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-emerald-700"><%= t("payments.products.full_property_report.name") %></p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight"><%= t("checkout.title") %></h1>
      <p class="mt-2 font-mono text-sm text-slate-500"><%= t("checkout.subtitle", identifier: @analysis.submitted_identifier) %></p>
      <div class="mt-7 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm leading-6 text-amber-950"><%= t("checkout.fake_banner") %></div>
      <%= form_with model: @order, url: report_orders_path(@analysis), class: "mt-7 space-y-5" do |form| %>
        <div>
          <%= form.label :email, t("checkout.email"), class: "mb-2 block text-sm font-bold" %>
          <%= form.email_field :email, required: true, autocomplete: "email", placeholder: t("checkout.email_placeholder"), class: "w-full rounded-xl border border-slate-300 px-4 py-3.5 outline-none focus:border-emerald-600 focus:ring-4 focus:ring-emerald-100" %>
          <% if @order.errors.any? %><p class="mt-2 text-sm font-semibold text-rose-700"><%= t("checkout.invalid_email") %></p><% end %>
        </div>
        <%= form.submit t("checkout.submit"), class: "w-full cursor-pointer rounded-xl bg-emerald-950 px-5 py-4 text-sm font-black text-white hover:bg-emerald-800" %>
      <% end %>
    </div>
    <aside class="bg-slate-950 p-7 text-white sm:p-10">
      <h2 class="text-sm font-bold uppercase tracking-wide text-slate-400"><%= t("checkout.includes_title") %></h2>
      <p class="mt-4 text-lg leading-8 text-slate-200"><%= t("checkout.includes") %></p>
      <dl class="mt-10 space-y-4 border-t border-slate-800 pt-6 text-sm"><div class="flex justify-between gap-4"><dt class="text-slate-400"><%= t("checkout.product") %></dt><dd class="font-bold"><%= t(@product.fetch(:name_key)) %></dd></div><div class="flex justify-between gap-4 text-lg"><dt class="text-slate-400"><%= t("checkout.amount") %></dt><dd class="font-black"><%= formatted_price(@product.fetch(:amount_cents), @product.fetch(:currency)) %></dd></div></dl>
    </aside>
  </div>
</section>
