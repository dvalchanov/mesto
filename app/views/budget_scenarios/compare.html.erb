<% content_for :title, localized_copy("Сравнение на сметки | #{product_name}", "Compare Calculations | #{product_name}") %>
<% content_for :description, localized_copy("Лично сравнение на два варианта за разходите и финансирането при покупка на имот.", "A private comparison of two property purchase cost and financing scenarios.") %>
<% content_for :head do %><meta name="robots" content="noindex,nofollow"><% end %>
<section class="scenario-page"><div class="site-shell">
  <div class="scenario-page__heading"><div><p class="eyebrow"><span></span><%= localized_copy("Сравнение на сметки", "Compare calculations") %></p><h1><%= @first.title %> <span><%= localized_copy("и", "and") %></span> <%= @second.title %></h1><p><%= localized_copy("Сравнението показва как се променят резултатите при различни допускания. Само ти можеш да прецениш кой вариант е по-подходящ за теб.", "The comparison shows how the results change under different assumptions. Only you can decide which option is more suitable for you.") %></p></div><%= link_to localized_copy("Назад към сметките", "Back to saved calculations"), budget_scenarios_path, class: "button button--outline" %></div>
  <div class="comparison-table" role="table" aria-label="<%= localized_copy("Сравнение на две сметки", "Comparison of two calculations") %>">
    <div class="comparison-table__head" role="row"><span role="columnheader"><%= localized_copy("Показател", "Indicator") %></span><strong role="columnheader"><%= @first.title %></strong><strong role="columnheader"><%= @second.title %></strong><strong role="columnheader"><%= localized_copy("Разлика", "Difference") %></strong></div>
    <% { "included_outlay_cents" => localized_copy("Общо планирани плащания", "Total planned payments"), "own_funding_cents" => localized_copy("Оставащи собствени средства", "Remaining own funds required"), "monthly_payment_cents" => localized_copy("Месечна вноска", "Monthly payment"), "total_interest_cents" => localized_copy("Обща лихва", "Total interest"), "peak_shortfall_cents" => localized_copy("Най-голям недостиг", "Largest funding shortfall") }.each do |key, label| %>
      <% metric = @comparison.dig("metrics", key) %><div role="row"><span role="cell"><%= label %></span><span role="cell"><%= format_eur(metric["first"]) %></span><span role="cell"><%= format_eur(metric["second"]) %></span><strong role="cell"><%= format_eur(metric["difference"]) %></strong></div>
    <% end %>
  </div>
  <div class="calculator-note"><strong><%= localized_copy("Как да четеш сравнението", "How to read the simile") %></strong><p><%= localized_copy("Ако промениш лихвата, тя се приема за постоянна през целия срок. Ако преместиш едно плащане, останалите договорни срокове не се променят автоматично.", "If you change the interest rate, it is assumed to be constant throughout the term. If you move one payment, the remaining contract terms are not automatically changed.") %></p></div>
</div></section>
