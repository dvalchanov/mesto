<%= turbo_frame_tag "calculator-results", data: { sequence: params.dig(:calculator, :request_sequence).to_i } do %>
  <% costs = result.fetch("costs", {}) %>
  <% mortgage = result.fetch("mortgage", {}) %>
  <% funding = result.fetch("funding", {}) %>
  <div class="summary-card">
    <div class="summary-card__heading">
      <div><span>Твоята сметка</span><h2><%= result["complete"] ? "Обобщение" : "Междинен резултат" %></h2></div>
      <i class="summary-status <%= result['complete'] ? 'summary-status--complete' : '' %>"><%= result["complete"] ? "Изчислено" : "За уточняване" %></i>
    </div>
    <% if errors.present? %><div class="calculator-warning"><strong>Провери въведените стойности.</strong><%= errors.values.to_sentence %></div><% end %>
    <dl class="summary-metrics">
      <div><dt>Цена за плащане</dt><dd><%= format_eur(costs["payable_property_price_cents"]) %></dd></div>
      <div><dt><%= costs.fetch("unresolved_items", []).any? ? "Изчислени и въведени разходи" : "Включени допълнителни разходи" %></dt><dd><%= format_eur(costs["included_costs_cents"]) %></dd></div>
      <div class="summary-metrics__total"><dt>Общо планирани плащания</dt><dd><%= format_eur(costs["combined_included_outlay_cents"]) %></dd></div>
      <div><dt>Нужни собствени средства</dt><dd><%= format_eur(result["required_own_funds_cents"]) %></dd></div>
      <div><dt>Месечна вноска</dt><dd><%= format_eur(mortgage["regular_payment_cents"]) %></dd></div>
      <div><dt>Най-голям недостиг</dt><dd class="<%= 'is-negative' if funding['largest_funding_shortfall_cents'].to_i.positive? %>"><%= format_eur(funding["largest_funding_shortfall_cents"]) %></dd></div>
    </dl>
    <% if result.fetch("warnings", []).any? %>
      <% warning_count = result["warnings"].size %>
      <details class="summary-warnings">
        <summary><strong>Какво остава да уточниш</strong><em><%= warning_count %> <%= warning_count == 1 ? "уточнение" : "уточнения" %></em></summary>
        <ul><% result["warnings"].each do |warning| %><li><%= warning %></li><% end %></ul>
      </details>
    <% end %>
  </div>

  <% if costs.fetch("lines", []).any? %>
    <details class="summary-detail" open>
      <summary>Цена и разходи <span><%= format_eur(costs["included_costs_cents"]) %></span></summary>
      <div class="summary-lines">
        <% costs["lines"].each do |line| %>
          <div class="summary-line <%= 'summary-line--unknown' if line['status'] == 'unresolved' %>">
            <div><strong><%= line["label"] %></strong><small><%= line["status"] == "unresolved" ? "Неизвестно" : calculator_provenance_label(line["provenance"]) %></small></div>
            <span><%= line["status"] == "unresolved" ? "непопълнено" : format_eur(line["amount_cents"]) %></span>
            <% if line["explanation"].present? %><details><summary>Как е изчислено?</summary><p><%= line["explanation"] %></p><% if line["source_url"].present? %><%= link_to "Официален източник", line["source_url"], target: "_blank", rel: "noopener" %><% end %></details><% end %>
          </div>
        <% end %>
      </div>
      <dl class="summary-subtotals">
        <div><dt>Придобиване</dt><dd><%= format_eur(costs["acquisition_costs_cents"]) %></dd></div>
        <div><dt>Финансиране</dt><dd><%= format_eur(costs["financing_costs_cents"]) %></dd></div>
        <div><dt>След покупката</dt><dd><%= format_eur(costs["after_purchase_costs_cents"]) %></dd></div>
        <div><dt>Отделни месечни разходи</dt><dd><%= format_eur(costs["recurring_monthly_costs_cents"]) %></dd></div>
      </dl>
    </details>
  <% end %>

  <% if mortgage["complete"] && mortgage["principal_cents"].to_i.positive? %>
    <details class="summary-detail">
      <summary>Финансиране <span><%= format_eur(mortgage["regular_payment_cents"]) %> / мес.</span></summary>
      <dl class="summary-subtotals">
        <div><dt>Главница</dt><dd><%= format_eur(mortgage["principal_cents"]) %></dd></div>
        <div><dt>Обща лихва</dt><dd><%= format_eur(mortgage["total_interest_cents"]) %></dd></div>
        <div><dt>Последна коригирана вноска</dt><dd><%= format_eur(mortgage["final_payment_cents"]) %></dd></div>
        <div><dt>Вноска + включени месечни такси</dt><dd><%= format_eur(mortgage["total_regular_monthly_outflow_cents"]) %></dd></div>
      </dl>
      <p class="summary-explanation">Анюитетна схема при постоянна номинална лихва за целия срок. Това не е ГПР, одобрение или официален погасителен план.</p>
      <div class="amortization-visual" role="img" aria-label="Дял на главницата и лихвата в общо платената сума">
        <% total = mortgage["total_principal_and_interest_cents"].to_i %>
        <% principal_width = total.positive? ? (mortgage["principal_cents"].to_d / total * 100).round(1) : 0 %>
        <span style="width: <%= principal_width %>%"></span><i style="width: <%= 100 - principal_width %>%"></i>
      </div>
      <details class="amortization-table-wrap"><summary>Покажи погасителния план</summary><table class="amortization-table"><thead><tr><th>№</th><th>Начална главница</th><th>Лихва</th><th>Главница</th><th>Вноска</th><th>Остатък</th></tr></thead><tbody><% mortgage["schedule"].each do |row| %><tr><td><%= row["number"] %></td><td><%= format_eur(row["opening_balance_cents"]) %></td><td><%= format_eur(row["interest_cents"]) %></td><td><%= format_eur(row["principal_cents"]) %></td><td><%= format_eur(row["payment_cents"]) %></td><td><%= format_eur(row["closing_balance_cents"]) %></td></tr><% end %></tbody></table></details>
    </details>
  <% end %>

  <% if funding.fetch("rows", []).any? %>
    <details class="summary-detail">
      <summary>График и налични средства <span><%= funding["complete"] ? "по реда на плащанията" : "ориентировъчно" %></span></summary>
      <div class="ledger-table-wrap"><table class="ledger-table"><thead><tr><th>Събитие</th><th>Към продавача</th><th>Разходи</th><th>Ипотека</th><th>Собствени средства</th><th>Оставаща наличност</th></tr></thead><tbody><% funding["rows"].each do |row| %><tr><th><%= row["label"].presence || row["event_key"] %><small><%= row["date"].presence || "по ред на етапа" %></small></th><td><%= format_eur(row["seller_payment_cents"]) %></td><td><%= format_eur(row["additional_costs_cents"]) %></td><td><%= format_eur(row["mortgage_applied_cents"]) %></td><td><%= format_eur(row["own_cash_required_cents"]) %></td><td class="<%= 'is-negative' if row['projected_own_cash_cents'].negative? %>"><%= format_eur(row["projected_own_cash_cents"]) %></td></tr><% end %></tbody></table></div>
      <dl class="summary-subtotals">
        <div><dt>Оставащи нужни собствени средства</dt><dd><%= format_eur(funding["remaining_own_funding_cents"]) %></dd></div>
        <div><dt>Собствени средства преди първото усвояване</dt><dd><%= format_eur(funding["own_funds_before_first_mortgage_cents"]) %></dd></div>
        <div><dt>Най-ниска прогнозна наличност</dt><dd><%= format_eur(funding["minimum_projected_cash_cents"]) %></dd></div>
        <div><dt>Допълнителни средства за запазване на резерва</dt><dd><%= format_eur(funding["additional_funding_for_reserve_cents"]) %></dd></div>
      </dl>
    </details>
  <% end %>

  <p class="calculator-legal-note">Тази сметка е ориентир за планиране. Официалните източници са проверени на 06.09.2026 г., но съдържанието все още не е прегледано от правен и данъчен специалист. Потвърди договорните суми, данъчното третиране и приложимите такси със страните и специалистите по сделката.</p>
<% end %>
