<% content_for :title, localized_copy("Ипотечен калкулатор за месечна вноска | #{product_name}", "Mortgage Payment Calculator | #{product_name}") %>
<% content_for :description, localized_copy("Изчисли ориентировъчната месечна вноска, общата лихва и погасителния план за ипотечен кредит в евро. Без регистрация.", "Estimate your monthly mortgage payment, total interest and repayment schedule in euros. No registration required.") %>

<section class="calculator-hero calculator-hero--mortgage">
  <div class="site-shell calculator-hero__inner">
    <div>
      <p class="eyebrow"><span></span><%= localized_copy("Ипотечен калкулатор", "Mortgage calculator") %></p>
      <h1><%= localized_copy("Каква би била месечната ти вноска?", "What would your monthly payment be?") %></h1>
      <p><%= localized_copy("Изчисли кредит с постоянна номинална лихва. Резултатът не е ГПР, банкова оферта, одобрение или официален погасителен план.", "Calculate a loan with a constant nominal interest rate. The result is not an APR, bank offer, approval or formal repayment plan.") %></p>
    </div>
    <%= link_to localized_copy("Към пълния план за покупка →", "To the full purchase plan →"), purchase_calculator_path, class: "button button--outline" %>
  </div>
</section>

<div class="site-shell mortgage-workspace" data-controller="calculator-form" data-calculator-form-draft-key-value="mortgage" data-calculator-form-draft-enabled-value="<%= request.get? && params[:example].blank? %>" data-calculator-form-reset-url-value="<%= mortgage_calculator_path %>" data-action="turbo:before-frame-render@document->calculator-form#guard">
  <div class="calculator-reset-bar" data-calculator-form-target="resetter" <%= "hidden" if params[:example].blank? && params[:calculator].blank? %>>
    <button type="button" class="text-link calculator-reset" data-action="calculator-form#reset"><%= mesto_icon("refresh", css_class: "size-4") %><span><%= localized_copy("Започни отначало", "Start over") %></span></button>
  </div>
  <%= form_with scope: :calculator, url: calculate_mortgage_calculator_path, method: :post,
    html: { class: "mortgage-form", data: { calculator_form_target: "form", turbo_frame: "mortgage-results", action: "input->calculator-form#rememberInput change->calculator-form#queue" } } do |form| %>
    <%= form.hidden_field :request_sequence, value: 0, data: { calculator_form_target: "sequence" } %>
    <button type="submit" class="hidden" tabindex="-1" aria-hidden="true" data-calculator-form-target="submitter"><%= localized_copy("Изчисли", "Calculate") %></button>
    <div class="calculator-panel__heading"><div><span>EUR</span><h2><%= localized_copy("Данни за изчислението", "Calculation data") %></h2></div><p><%= localized_copy("Няма предварително зададена „пазарна“ лихва.", "There is no pre-set \"market\" rate.") %></p></div>
    <div class="calculator-fields">
      <div class="calculator-field calculator-field--strong"><%= form.label :principal, localized_copy("Размер на кредита", "Amount of the loan") %><div class="money-field"><%= form.text_field :principal, value: money_input_value(mortgage_input("principal_cents")), inputmode: "decimal", placeholder: "100 000,00" %><span>€</span></div><%= calculator_error(@normalizer&.errors, "principal") %></div>
      <div class="calculator-field"><%= form.label :annual_interest_rate, localized_copy("Годишна номинална лихва", "Annual nominal interest rate") %><div class="money-field"><%= form.text_field :annual_interest_rate, value: mortgage_input("annual_interest_rate"), inputmode: "decimal", placeholder: localized_copy("напр. 3,5", "e.g. 3.5") %><span>%</span></div><small><%= localized_copy("Въведената лихва служи само за това изчисление и не е банкова оферта.", "The interest rate entered is for this calculation only and is not a bank offer.") %></small></div>
      <div class="calculator-field"><%= form.label :term_years, localized_copy("Срок", "Term") %><div class="money-field money-field--unit"><%= form.number_field :term_years, value: mortgage_input("term_months").to_i.positive? ? mortgage_input("term_months").to_i / 12 : nil, min: 1, max: 50, placeholder: "30" %><span><%= localized_copy("години", "years") %></span></div></div>
      <div class="calculator-field"><%= form.label :monthly_charges, localized_copy("Други месечни разходи", "Other monthly expenses") %><div class="money-field"><%= form.text_field :monthly_charges, value: money_input_value(mortgage_input("monthly_charges_cents")), inputmode: "decimal", placeholder: "0,00" %><span>€</span></div><small><%= localized_copy("Показват се отделно от главница и лихва.", "They are shown separately from principal and interest.") %></small></div>
    </div>
    <div class="calculator-form__footer">
      <%= link_to localized_copy("Виж примерна сметка", "View an example"), mortgage_calculator_path(example: 1), class: "button button--outline button--small" %>
    </div>
  <% end %>
  <aside class="calculator-summary"><%= render "calculators/mortgage_results", result: @mortgage_result, errors: @normalizer&.errors.to_h %></aside>
</div>
