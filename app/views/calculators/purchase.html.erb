<% content_for :title, "Калкулатор за покупка на имот | #{product_name}" %>
<% content_for :description, "Сметни в евро разходите по покупката, нужните собствени средства, ипотечната вноска и кога ще ти трябват парите." %>
<% if @scenario %><% content_for :head do %><meta name="robots" content="noindex,nofollow"><% end %><% end %>

<section class="calculator-hero calculator-hero--purchase">
  <div class="site-shell calculator-hero__inner">
    <div class="calculator-hero__copy">
      <p class="eyebrow">Калкулатор за покупка на имот</p>
      <h1>Колко ще ти струва покупката - и кога ще ти трябват парите?</h1>
      <p>Сметни разходите, собствените средства и плащанията по твоя сценарий. Можеш да започнеш и без избран имот.</p>
      <div class="calculator-hero__actions">
        <%= link_to "Започни сметката", "#purchase-calculator", class: "button button--primary" %>
        <%= link_to purchase_calculator_path(example: 1), class: "text-link" do %>Виж примерен сценарий<%= mesto_icon("arrow-right", css_class: "size-4") %><% end %>
      </div>
    </div>
    <div class="calculator-hero__aside">
      <div class="calculator-plan-visual" aria-hidden="true">
        <div class="calculator-plan-visual__heading"><span>Парите във времето</span><b>EUR</b></div>
        <div class="calculator-plan-visual__canvas">
          <svg viewBox="0 0 260 142" fill="none">
            <g class="calculator-plan-visual__grid">
              <path d="M1 24.5h258M1 59.5h258M1 94.5h258M1 129.5h258M35.5 1v140M89.5 1v140M143.5 1v140M197.5 1v140M251.5 1v140"/>
            </g>
            <path class="calculator-plan-visual__area" d="M8 124V105h48V89h53V69h53V48h50V25h40v107H8v-8Z"/>
            <path class="calculator-plan-visual__route" d="M8 105h48V89h53V69h53V48h50V25h40"/>
            <path class="calculator-plan-visual__source" d="M8 41h32l22 48M8 70h54l45-1"/>
            <rect class="calculator-plan-visual__node" x="51" y="84" width="10" height="10"/>
            <rect class="calculator-plan-visual__node" x="104" y="64" width="10" height="10"/>
            <rect class="calculator-plan-visual__node calculator-plan-visual__node--accent" x="207" y="20" width="10" height="10"/>
          </svg>
        </div>
        <div class="calculator-plan-visual__steps">
          <span><b>01</b>Цена</span>
          <span><b>02</b>Средства</span>
          <span><b>03</b>Моменти</span>
        </div>
      </div>
      <div class="calculator-hero__benefits" aria-label="Предимства на калкулатора">
        <span>Безплатно</span>
        <span>Без регистрация</span>
        <span>Без банкова оферта</span>
      </div>
    </div>
  </div>
</section>

<% if @scenario %>
  <section class="site-shell saved-scenario-bar" aria-label="Запазен сценарий">
    <div>
      <span>Запазена сметка</span>
      <strong><%= @scenario.title %></strong>
      <small>Изчислена <%= l(@scenario.calculated_at, format: :short) %> · двигател <%= @scenario.engine_version %></small>
      <% if @scenario.buyer_journey %><small>Свързан личен план: <%= @scenario.buyer_journey.label.presence || "без име" %></small><% end %>
    </div>
    <div class="saved-scenario-bar__actions">
      <%= form_with model: @scenario, url: budget_scenario_path(@scenario), method: :patch, class: "scenario-rename" do |form| %>
        <%= form.label :title, "Преименувай", class: "sr-only" %>
        <%= form.text_field :title, maxlength: 80 %>
        <%= form.submit "Запази име", class: "button button--outline button--small" %>
      <% end %>
      <%= button_to "Дублирай", duplicate_budget_scenario_path(@scenario), class: "button button--clear button--small" %>
      <%= button_to "Изтрий", budget_scenario_path(@scenario), method: :delete, class: "button button--small button--danger", data: { turbo_confirm: "Да изтрия ли тази сметка?" } %>
    </div>
    <% if @scenario.stale_rules? %>
      <div class="calculator-warning">Има различни версии на правилата. Запазеният резултат не е променен автоматично. <%= button_to "Преизчисли изрично", recalculate_budget_scenario_path(@scenario), class: "text-link" %></div>
    <% end %>
  </section>
<% end %>

<div id="purchase-calculator" class="site-shell calculator-workspace" data-controller="calculator-form calculator-tabs select-menu schedule-editor" data-calculator-form-draft-key-value="purchase" data-calculator-form-draft-enabled-value="<%= request.get? && params[:example].blank? && !@scenario %>" data-calculator-form-reset-url-value="<%= purchase_calculator_path %>" data-action="turbo:before-frame-render@document->calculator-form#guard click->calculator-form#rememberInterfaceState">
  <div class="calculator-reset-bar" data-calculator-form-target="resetter" <%= "hidden" if params[:example].blank? && !@scenario && params[:calculator].blank? %>>
    <button type="button" class="text-link calculator-reset" data-action="calculator-form#reset"><%= mesto_icon("refresh", css_class: "size-4") %><span>Започни отначало</span></button>
  </div>
  <%= form_with scope: :calculator, url: calculate_purchase_calculator_path, method: :post,
    html: { class: "calculator-form", data: { calculator_form_target: "form", turbo_frame: "calculator-results", action: "input->calculator-form#rememberInput change->calculator-form#queue" } } do |form| %>
    <%= form.hidden_field :request_sequence, value: 0, data: { calculator_form_target: "sequence" } %>
    <button type="submit" class="hidden" aria-hidden="true" tabindex="-1" data-calculator-form-target="submitter">Преизчисли</button>

    <nav class="calculator-tabs" aria-label="Раздели на калкулатора" role="tablist">
      <button type="button" role="tab" aria-selected="true" data-calculator-tabs-target="tab" data-section="costs" data-action="calculator-tabs#show"><span>01</span> Цена и разходи</button>
      <button type="button" role="tab" aria-selected="false" data-calculator-tabs-target="tab" data-section="financing" data-action="calculator-tabs#show"><span>02</span> Финансиране</button>
      <button type="button" role="tab" aria-selected="false" data-calculator-tabs-target="tab" data-section="schedule" data-action="calculator-tabs#show"><span>03</span> График на плащанията</button>
    </nav>

    <section class="calculator-panel" data-calculator-tabs-target="panel" data-section="costs" role="tabpanel">
      <div class="calculator-panel__heading">
        <div><span>01</span><h2>Цена и разходи</h2></div>
        <p>Автоматичните пера използват проверени правила само там, където имаме надежден източник.</p>
      </div>

      <div class="calculator-fields calculator-fields--two">
        <div class="calculator-field calculator-field--strong">
          <%= form.label :property_price, "Цена по сделката" %>
          <div class="money-field"><%= form.text_field :property_price, value: money_input_value(calculator_input("property_price_cents")), inputmode: "decimal", placeholder: "300 000,00", aria: { describedby: "price-hint" } %><span>€</span></div>
          <small id="price-hint">Въведи общата цена, освен ако маркираш част като допълнителна.</small>
          <%= calculator_error(@normalizer&.errors, "property_price") %>
        </div>
        <div class="calculator-field">
          <%= form.label :municipality, "Община" %>
          <%= form.select :municipality, [["Столична община", "sofia"], ["Друга община", "other"]], { selected: calculator_input("municipality", "sofia") }, data: { action: "change->calculator-form#toggleMunicipality" } %>
          <small>Автоматично проверена местна ставка засега има само за София.</small>
        </div>
        <div class="calculator-field" data-calculator-form-target="manualMunicipality" <%= 'hidden' unless calculator_input("municipality") == "other" %>>
          <%= form.label :manual_local_tax_rate, "Ръчно въведена местна ставка" %>
          <div class="money-field"><%= form.text_field :manual_local_tax_rate, value: calculator_input("manual_local_tax_rate"), inputmode: "decimal", placeholder: "напр. 2,5" %><span>%</span></div>
          <small>Непроверено потребителско допускане - не се прилага софийската ставка.</small>
        </div>
        <div class="calculator-field">
          <%= form.label :transaction_date, "Дата на сделката (по избор)" %>
          <%= form.date_field :transaction_date, value: calculator_input("transaction_date") %>
          <small>За бъдеща дата непроменените правила са допускане.</small>
        </div>
        <div class="calculator-field">
          <%= form.label :tax_assessment, "Данъчна оценка (по избор)" %>
          <div class="money-field"><%= form.text_field :tax_assessment, value: money_input_value(calculator_input("tax_assessment_cents")), inputmode: "decimal", placeholder: "Неизвестна" %><span>€</span></div>
          <small>Нужна е за сравнение с уговорената цена. <%= education_link("document.tax_assessment", "Какво е данъчна оценка?") %></small>
        </div>
        <div class="calculator-field">
          <%= form.label :transaction_cost_share, "Твой планиран дял от автоматичните разходи" %>
          <div class="money-field"><%= form.text_field :transaction_cost_share, value: calculator_input("transaction_cost_share_percent", "100"), inputmode: "decimal" %><span>%</span></div>
          <small>Видимо допускане за планиране, не универсално правило за отговорността между страните.</small>
        </div>
        <fieldset class="calculator-field calculator-field--wide">
          <legend>Как е цитирана цената?</legend>
          <div class="segmented-options">
            <% [["Крайна цена за плащане", "final"], ["Изрично без ДДС", "net"], ["Не е ясно", "uncertain"]].each do |label, value| %>
              <label><%= form.radio_button :price_vat_treatment, value, checked: calculator_input("price_vat_treatment", "final") == value, data: { action: "change->calculator-form#togglePropertyVat" } %><span><%= label %></span></label>
            <% end %>
          </div>
          <div class="inline-confirmation" data-calculator-form-target="propertyVat" <%= 'hidden' unless calculator_input("price_vat_treatment") == "net" %>>
            <label><%= form.check_box :property_vat_confirmed, checked: calculator_input("property_vat_confirmed") %> Потвърждавам, че ставката е приложима към тази оферта</label>
            <div class="money-field money-field--short"><%= form.text_field :property_vat_rate, value: calculator_input("property_vat_rate"), placeholder: "20", inputmode: "decimal" %><span>%</span></div>
          </div>
          <small>Ново строителство само по себе си не добавя автоматично ДДС.</small>
        </fieldset>
      </div>

      <details class="calculator-disclosure">
        <summary><span>Разбивка на цената</span><small>Избягва двойното броене на гараж или паркомясто.</small></summary>
        <div class="line-editor">
          <% CalculatorsHelper::COMPONENTS.each do |key, label| %>
            <div class="line-editor__row">
              <%= hidden_field_tag "calculator[components][#{key}][key]", key %>
              <%= hidden_field_tag "calculator[components][#{key}][label]", label %>
              <strong><%= label %></strong>
              <div class="money-field"><%= text_field_tag "calculator[components][#{key}][amount]", money_input_value(component_input(key, "amount_cents")), inputmode: "decimal", placeholder: "0,00" %><span>€</span></div>
              <%= select_tag "calculator[components][#{key}][price_relation]", options_for_select([["Включено в общата цена", "included"], ["Допълнително към нея", "additional"]], component_input(key, "price_relation") || "included"), aria: { label: "Отношение към цената за #{label}" } %>
            </div>
          <% end %>
        </div>
      </details>

      <details class="calculator-disclosure" open>
        <summary><span>Други разходи</span><small>Добави само разходите, които се отнасят за твоята покупка.</small></summary>
        <div class="cost-editor" data-controller="cost-editor">
          <div class="cost-editor__intro">
            <strong>Какво вече е включено?</strong>
            <p>Местният данък, таксата за вписване на покупката и основната нотариална такса се изчисляват автоматично. Тук добавяш само останалите разходи: отметни перо и избери дали имаш точна сума, процент, приблизителна сума или все още не знаеш.</p>
          </div>
          <% CalculatorsHelper::CALCULATOR_COSTS.group_by { _1[:category] }.each do |category, costs| %>
            <% category_meta = CalculatorsHelper::COST_CATEGORIES.fetch(category) %>
            <% category_open = category == "acquisition" || costs.any? { cost_input(_1, "included") == true } %>
            <details class="cost-editor__group" <%= "open" if category_open %>>
              <summary>
                <span><strong><%= category_meta[:label] %></strong><small><%= category_meta[:description] %></small></span>
                <em><%= costs.length %> възможности</em>
              </summary>
              <div class="cost-editor__group-items"><%= render partial: "calculators/cost_fields", collection: costs, as: :cost %></div>
            </details>
          <% end %>
        </div>
      </details>
    </section>

    <section class="calculator-panel" data-calculator-tabs-target="panel" data-section="financing" role="tabpanel" hidden>
      <div class="calculator-panel__heading">
        <div><span>02</span><h2>Финансиране</h2></div>
        <p>Ипотеката е източник на средства, не допълнителен разход по покупката.</p>
      </div>
      <fieldset class="calculator-field calculator-field--wide">
        <legend>Как ще финансираш покупката?</legend>
        <div class="segmented-options">
          <label><%= form.radio_button :financing_mode, "own_funds", checked: calculator_input("financing_mode", "own_funds") == "own_funds", data: { action: "change->calculator-form#toggleFinancing" } %><span>Само собствени средства</span></label>
          <label><%= form.radio_button :financing_mode, "mortgage", checked: calculator_input("financing_mode") == "mortgage", data: { action: "change->calculator-form#toggleFinancing" } %><span>С ипотека</span></label>
        </div>
      </fieldset>
      <div class="calculator-financing-details" data-calculator-form-target="mortgageFields" <%= 'hidden' unless calculator_input("financing_mode") == "mortgage" %>>
        <div class="calculator-fields calculator-fields--two">
          <fieldset class="calculator-field calculator-field--wide">
            <legend>Кое число искаш да зададеш?</legend>
            <div class="segmented-options">
              <label><%= form.radio_button :loan_primary_input, "principal", checked: calculator_input(["loan", "primary_input"], "principal") == "principal" %><span>Размер на кредита</span></label>
              <label><%= form.radio_button :loan_primary_input, "own_contribution", checked: calculator_input(["loan", "primary_input"]) == "own_contribution" %><span>Самоучастие към цената</span></label>
            </div>
          </fieldset>
          <div class="calculator-field"><%= form.label :loan_principal, "Размер на кредита" %><div class="money-field"><%= form.text_field :loan_principal, value: money_input_value(calculator_input(["loan", "principal_cents"])), inputmode: "decimal", placeholder: "240 000,00" %><span>€</span></div></div>
          <div class="calculator-field"><%= form.label :own_contribution, "Самоучастие към цената" %><div class="money-field"><%= form.text_field :own_contribution, value: money_input_value(calculator_input(["loan", "own_contribution_cents"])), inputmode: "decimal", placeholder: "60 000,00" %><span>€</span></div><small>Не включва данъци, такси и други разходи.</small></div>
          <div class="calculator-field"><%= form.label :annual_interest_rate, "Годишна номинална лихва" %><div class="money-field"><%= form.text_field :annual_interest_rate, value: calculator_input(["loan", "annual_interest_rate"]), inputmode: "decimal", placeholder: "Без предварително зададена ставка" %><span>%</span></div><small>Примерна лихва - не е банкова оферта. Това не е ГПР. <%= education_link("term.mortgage", "За ипотеката") %></small></div>
          <div class="calculator-field"><%= form.label :term_years, "Срок" %><div class="money-field money-field--unit"><%= form.number_field :term_years, value: calculator_input(["loan", "term_months"]).to_i.positive? ? calculator_input(["loan", "term_months"]).to_i / 12 : nil, min: 1, max: 50 %><span>години</span></div></div>
          <div class="calculator-field"><%= form.label :monthly_charges, "Други месечни такси по кредита" %><div class="money-field"><%= form.text_field :monthly_charges, value: money_input_value(calculator_input(["loan", "monthly_charges_cents"])), inputmode: "decimal", placeholder: "0,00" %><span>€</span></div></div>
          <div class="calculator-field"><%= form.label :bank_valuation, "Банкова оценка (по избор)" %><div class="money-field"><%= form.text_field :bank_valuation, value: money_input_value(calculator_input(["loan", "bank_valuation_cents"])), inputmode: "decimal", placeholder: "Не е равна автоматично на цената" %><span>€</span></div></div>
          <div class="calculator-field"><%= form.label :assumed_financing_percentage, "Хипотетичен процент финансиране" %><div class="money-field"><%= form.text_field :assumed_financing_percentage, value: calculator_input(["loan", "assumed_financing_percentage"]), inputmode: "decimal", placeholder: "без предварителна стойност" %><span>%</span></div><small>Използва се върху оценката само ако няма въведен размер на кредита.</small></div>
        </div>
      </div>
      <div class="calculator-fields calculator-fields--two calculator-fields--spaced calculator-fields--funding-basics">
        <div class="calculator-field calculator-field--strong"><%= form.label :starting_cash, "С колко собствени средства разполагаш към началото на този план?" %><div class="money-field"><%= form.text_field :starting_cash, value: money_input_value(calculator_input(["funding", "starting_cash_cents"])), inputmode: "decimal", placeholder: "Налични днес" %><span>€</span></div><small>Плащанията преди тази начална точка не се изваждат повторно.</small></div>
        <div class="calculator-field"><%= form.label :reserve, "Желан резерв след плащанията" %><div class="money-field"><%= form.text_field :reserve, value: money_input_value(calculator_input(["funding", "reserve_cents"])), inputmode: "decimal", placeholder: "0,00" %><span>€</span></div><small>Резервът е запазена наличност, не разход.</small></div>
      </div>
      <p class="calculator-financing-note" data-calculator-form-target="mortgageNote" <%= "hidden" unless calculator_input("financing_mode") == "mortgage" %>><strong>Сценарий, не банкова оферта.</strong> Одобрението не гарантира, че средствата са достъпни веднага.</p>
    </section>

    <section class="calculator-panel" data-calculator-tabs-target="panel" data-section="schedule" role="tabpanel" hidden>
      <div class="calculator-panel__heading">
        <div><span>03</span><h2>График на плащанията</h2></div>
        <p>Подреди плащанията по етапи и провери кога са нужни собствени средства или ипотека.</p>
      </div>
      <div class="template-picker">
        <div class="calculator-field">
          <label for="schedule-template">Хипотетичен шаблон</label>
          <select id="schedule-template" data-schedule-editor-target="template" data-action="change->schedule-editor#applyTemplate">
            <option value="">Избери умишлено…</option>
            <option value="10-10-80">10% / 10% / 80%</option>
            <option value="20-80">20% / 80%</option>
            <option value="custom">Празен персонален график</option>
          </select>
          <small>Шаблоните не са законово изискване или препоръка.</small>
        </div>
        <button type="button" class="button button--outline button--small" data-action="schedule-editor#add">+ Добави събитие</button>
      </div>
      <datalist id="schedule-event-labels">
        <% ["Резервация", "Предварителен договор", "Акт 14", "Акт 15", "Въвеждане в експлоатация", "Нотариално прехвърляне", "Предаване"].each do |label| %><option value="<%= label %>"><% end %>
      </datalist>
      <div class="schedule-editor" data-schedule-editor-target="list" data-action="input->schedule-editor#syncEventSelectors">
        <% Array(calculator_input("schedule", [])).each_with_index do |event, index| %>
          <%= render "calculators/schedule_event_fields", event:, index: %>
        <% end %>
      </div>

      <details class="calculator-disclosure" open>
        <summary><span>Резервационно плащане / капаро</span><small>Посочи изрично как го третираш в този сценарий.</small></summary>
        <div class="calculator-fields calculator-fields--two">
          <div class="calculator-field"><label for="reservation-amount">Реално платена сума</label><div class="money-field"><%= text_field_tag "calculator[reservation][amount]", money_input_value(calculator_input(["reservation", "amount_cents"])), id: "reservation-amount", inputmode: "decimal" %><span>€</span></div></div>
          <div class="calculator-field"><label for="reservation-treatment">Третиране</label><%= select_tag "calculator[reservation][treatment]", options_for_select([["Не е приложимо", "not_applicable"], ["Приспада се от цената", "credited"], ["Отделна такса", "separate_fee"], ["Не е ясно", "uncertain"]], calculator_input(["reservation", "treatment"], "not_applicable")), id: "reservation-treatment" %></div>
          <div class="calculator-field"><label for="reservation-credit-event">Към кое плащане се приспада?</label><%= select_tag "calculator[reservation][credit_event_key]", options_for_select([["Избери събитие…", ""]] + schedule_event_options, calculator_input(["reservation", "credit_event_key"])), id: "reservation-credit-event", data: { schedule_editor_target: "eventSelect" } %><small><%= education_link("document.reservation_agreement", "За резервационните споразумения") %></small></div>
          <label class="check-field"><%= check_box_tag "calculator[reservation][paid_before_start]", "1", calculator_input(["reservation", "paid_before_start"]) %><span>Платено е преди началната точка на този план</span></label>
        </div>
      </details>

      <div class="calculator-fields calculator-fields--two calculator-fields--spaced">
        <div class="calculator-field"><%= form.label :mortgage_availability_event_key, "При кое плащане ипотеката става достъпна?" %><%= form.select :mortgage_availability_event_key, schedule_event_options, { include_blank: "Избери плащане…", selected: calculator_input(["funding", "mortgage_availability_event_key"]) }, data: { schedule_editor_target: "eventSelect" } %><small>Средствата по кредита се използват само за допустими плащания към продавача.</small></div>
        <div class="calculator-field"><%= form.label :mortgage_confidence, "Сигурност на усвояването" %><%= form.select :mortgage_confidence, [["Хипотетично", "hypothetical"], ["Очаквано", "expected"], ["Потвърдено от теб", "confirmed"]], { selected: calculator_input(["funding", "mortgage_confidence"], "hypothetical") } %></div>
      </div>
      <details class="calculator-disclosure">
        <summary><span>Поетапни ипотечни усвоявания</span><small>По избор; ако ги попълниш, заменят еднократната наличност по-горе.</small></summary>
        <div class="calculator-fields calculator-fields--two">
          <% ["draw_1", "draw_2"].each do |draw_key| %>
            <% draw = Array(calculator_input(["funding", "mortgage_disbursements"], [])).find { _1["key"] == draw_key } || {} %>
            <div class="future-inflow">
              <strong>Ипотечно усвояване</strong>
              <div class="money-field"><%= text_field_tag "calculator[mortgage_disbursements][#{draw_key}][amount]", money_input_value(draw["amount_cents"]), inputmode: "decimal", placeholder: "0,00", aria: { label: "Размер на ипотечно усвояване" } %><span>€</span></div>
              <%= select_tag "calculator[mortgage_disbursements][#{draw_key}][event_key]", options_for_select([["Избери плащане…", ""]] + schedule_event_options, draw["event_key"]), aria: { label: "Събитие за ипотечно усвояване" }, data: { schedule_editor_target: "eventSelect" } %>
              <%= select_tag "calculator[mortgage_disbursements][#{draw_key}][confidence]", options_for_select([["Хипотетично", "hypothetical"], ["Очаквано", "expected"], ["Потвърдено от теб", "confirmed"]], draw["confidence"] || "hypothetical"), aria: { label: "Сигурност на ипотечното усвояване" } %>
            </div>
          <% end %>
        </div>
      </details>
      <p class="calculator-inline-warning">Одобрен кредит не се третира като налични пари преди избраното събитие. Плащания в един ден следват въведения ред.</p>

      <details class="calculator-disclosure">
        <summary><span>Бъдещи собствени постъпления</span><small>Не се извеждат от доход; въвеждаш ги изрично.</small></summary>
        <div class="calculator-fields calculator-fields--two">
          <% ["future_1", "future_2"].each do |inflow_key| %>
            <% inflow = Array(calculator_input(["funding", "own_inflows"], [])).find { _1["key"] == inflow_key } || {} %>
            <div class="future-inflow">
              <strong>Постъпление</strong>
              <div class="money-field"><%= text_field_tag "calculator[own_inflows][#{inflow_key}][amount]", money_input_value(inflow["amount_cents"]), inputmode: "decimal", placeholder: "0,00", aria: { label: "Размер на бъдещо постъпление" } %><span>€</span></div>
              <%= select_tag "calculator[own_inflows][#{inflow_key}][event_key]", options_for_select([["Избери плащане…", ""]] + schedule_event_options, inflow["event_key"]), aria: { label: "Събитие за бъдещо постъпление" }, data: { schedule_editor_target: "eventSelect" } %>
              <%= select_tag "calculator[own_inflows][#{inflow_key}][confidence]", options_for_select([["Хипотетично", "hypothetical"], ["Очаквано", "expected"], ["Потвърдено от теб", "confirmed"]], inflow["confidence"] || "expected"), aria: { label: "Сигурност на бъдещото постъпление" } %>
            </div>
          <% end %>
        </div>
      </details>

      <details class="calculator-disclosure">
        <summary><span>Запази сценария</span><small>По избор; именувана сметка за повторно отваряне и сравнение.</small></summary>
        <div class="calculator-save-grid">
          <div class="calculator-field"><%= form.label :title, "Име на сметката" %><%= form.text_field :title, value: calculator_input("title"), maxlength: 80, placeholder: "напр. Апартамент А" %></div>
          <% if guest_journeys.any? %>
            <div class="calculator-field"><%= form.label :buyer_journey_id, "Свържи с личен план (по избор)" %><%= form.select :buyer_journey_id, guest_journeys.map { |journey| [journey.label.presence || "План от #{l(journey.created_at.to_date)}", journey.id] }, { include_blank: "Без връзка", selected: calculator_input("buyer_journey_id") } %><small>Връзката не отбелязва урок или задача като завършени.</small></div>
          <% end %>
          <button type="submit" formaction="<%= @scenario ? save_budget_scenario_path(@scenario) : budget_scenarios_path %>" formtarget="_top" data-turbo="false" class="button button--secondary"><%= @scenario ? "Запази промените" : "Запази тази сметка" %></button>
          <p class="calculator-privacy">Временната чернова е само за текущия раздел. Запазената сметка остава достъпна в този браузър до <%= Rails.application.config.x.anonymous_journey_retention_days %> дни и може да се отвори, дублира и сравнява. Не се синхронизира между устройства и не се показва публично.</p>
        </div>
      </details>
    </section>

    <div class="calculator-form__footer">
      <button type="submit" class="button button--secondary">Преизчисли</button>
      <%= link_to "Зареди ясно означен пример", purchase_calculator_path(example: 1), class: "button button--outline button--small" %>
      <% if @scenarios&.any? %><%= link_to "Запазени сметки (#{@scenarios.size})", budget_scenarios_path, class: "text-link" %><% end %>
    </div>
  <% end %>

  <aside class="calculator-summary" aria-live="polite">
    <%= render "calculators/results", result: @result, errors: @normalizer&.errors.to_h %>
  </aside>
</div>

<template id="schedule-row-template">
  <%= render "calculators/schedule_event_fields", event: {}, index: "NEW_INDEX" %>
</template>
