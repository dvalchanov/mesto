<section class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8">
  <div class="mb-5 flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h2 class="text-xl font-bold"><%= t("reports.map.title") %></h2>
      <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600"><%= t("reports.map.description") %></p>
    </div>
    <p class="text-xs font-bold uppercase tracking-wide text-slate-500"><%= t("reports.map.precision", precision: t("reports.map.precisions.#{analysis.location_precision}")) %></p>
  </div>
  <% if analysis.centroid %>
    <% map_payload = report_map_payload(analysis, acts: local_assigns.fetch(:acts, AdministrativeAct.none)) %>
    <% properties = map_payload[:features].map { |feature| feature[:properties] || feature["properties"] || {} } %>
    <% map_layers = [
      ["selected", "layer_selected", "bg-emerald-800", true, false, ->(property) { %w[selected_location selected_object selected_building parcel].include?(property[:kind] || property["kind"]) }],
      ["buildings", "layer_buildings", "bg-slate-500", true, true, ->(property) { (property[:kind] || property["kind"]) == "nearby_building" }],
      ["schools", "layer_schools", "bg-sky-600", true, true, ->(property) { (property[:category] || property["category"]) == "schools" }],
      ["kindergartens", "layer_kindergartens", "bg-violet-600", true, true, ->(property) { (property[:category] || property["category"]) == "kindergartens" }],
      ["green_spaces", "layer_green_spaces", "bg-lime-700", true, true, ->(property) { (property[:category] || property["category"]) == "green_spaces" }],
      ["transit", "layer_transit", "bg-orange-700", true, true, ->(property) { (property[:category] || property["category"]) == "transit" }],
      ["planning", "layer_planning", "bg-orange-700", false, true, ->(property) { (property[:kind] || property["kind"]) == "planning" }],
      ["acts", "layer_acts", "bg-red-700", false, true, ->(property) { (property[:kind] || property["kind"]) == "act" }],
      ["flood", "layer_flood", "bg-blue-600", false, true, ->(property) { (property[:category] || property["category"]) == "flood_risk" }]
    ] %>
    <% content_for :head do %><link href="https://cdn.jsdelivr.net/npm/maplibre-gl@5.7.1/dist/maplibre-gl.css" rel="stylesheet"><% end %>
    <div data-controller="property-map" data-property-map-payload-value="<%= map_payload.to_json %>" data-property-map-style-url-value="<%= Rails.application.config.x.map_style_url %>" data-property-map-source-label-value="<%= t("reports.map.source_link") %>">
      <div class="mb-3 flex flex-wrap gap-2" aria-label="<%= t("reports.map.layers_label") %>">
        <% map_layers.each do |layer, label, swatch, visible, toggleable, matcher| %>
          <% count = properties.count(&matcher) %>
          <% next if count.zero? %>
          <% if toggleable %>
            <button type="button" data-action="property-map#toggle" data-layer="<%= layer %>" aria-pressed="<%= visible %>" class="inline-flex items-center gap-2 rounded-full border border-slate-300 bg-white px-3 py-1.5 text-xs font-bold text-slate-700 transition-opacity <%= 'opacity-40' unless visible %>">
              <span class="size-2 rounded-full <%= swatch %>" aria-hidden="true"></span>
              <%= t("reports.map.#{label}", count:) %>
            </button>
          <% else %>
            <span class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-bold text-slate-700">
              <span class="size-2 rounded-full <%= swatch %>" aria-hidden="true"></span>
              <%= t("reports.map.#{label}", count:) %>
            </span>
          <% end %>
        <% end %>
      </div>
      <div class="map-frame"><div data-property-map-target="canvas" class="h-[28rem] bg-slate-100" role="region" aria-label="<%= t("reports.map.canvas_label", identifier: analysis.submitted_identifier) %>"></div></div>
      <p class="mt-3 text-xs leading-5 text-slate-500"><%= t("reports.map.registry_note") %></p>
      <% if analysis.identifier_level == "individual_object" %><p class="mt-1 text-xs leading-5 text-slate-500"><%= t("reports.map.object_note") %></p><% end %>
    </div>
  <% else %>
    <div class="grid min-h-56 place-items-center rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-8 text-center text-sm leading-6 text-slate-600"><%= t("reports.map.unavailable") %></div>
  <% end %>
</section>
