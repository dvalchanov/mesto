<section class="rounded-[2rem] border border-slate-200 bg-white p-6 sm:p-8">
  <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <p class="text-xs font-black uppercase tracking-[0.16em] text-emerald-700"><%= t("reports.findings.eyebrow") %></p>
      <h2 class="mt-2 text-2xl font-black tracking-tight"><%= t("reports.findings.title") %></h2>
      <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600"><%= t("reports.findings.description") %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <% AdministrativeAct::REGISTRY_KINDS.each do |kind| %>
        <% count = analysis.metrics.dig("direct_activity", "by_registry", kind).to_i %>
        <span class="rounded-full px-3 py-1.5 text-xs font-bold <%= count.positive? ? 'bg-emerald-50 text-emerald-800' : 'bg-slate-100 text-slate-600' %>"><%= t("reports.acts.short_kinds.#{kind}") %>: <%= count %></span>
      <% end %>
    </div>
  </div>

  <% if acts.any? %>
    <div class="mt-7 space-y-5">
      <% acts.each do |act| %>
        <%= render "administrative_act", act:, preview: true %>
      <% end %>
    </div>
    <% if analysis.metrics.dig("direct_activity", "total").to_i > acts.length %>
      <p class="mt-5 text-sm font-semibold text-slate-600"><%= t("reports.findings.more_records", count: analysis.metrics.dig("direct_activity", "total").to_i - acts.length) %></p>
    <% end %>
  <% else %>
    <div class="mt-7 rounded-2xl border border-slate-200 bg-slate-50 p-5">
      <p class="font-bold text-slate-900"><%= t("reports.findings.no_match_title") %></p>
      <p class="mt-2 text-sm leading-6 text-slate-600"><%= t("reports.findings.no_match_body") %></p>
    </div>
  <% end %>
</section>
