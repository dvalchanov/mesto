<% incomplete_runs = source_runs.select do |run|
     run.status.in?(%w[failed unavailable]) &&
       !Analysis::CoverageBuilder::NON_BLOCKING_SOURCE_KEYS.include?(run.source_key)
   end %>
<% dependent_runs = incomplete_runs.select { |run| source_result_key(run, analysis:) == "needs_location" } %>
<% blocking_runs = incomplete_runs - dependent_runs %>
<% outside_coverage = blocking_runs.any? { |run| run.error_class == "DataCoverage::OutsideSearchCoverage" } %>

<section class="report-unavailable" data-testid="paid-report-unavailable" aria-labelledby="paid-report-unavailable-title">
  <header class="report-section__header">
    <div>
      <p class="report-section-label"><%= t("reports.paid_unavailable.eyebrow") %></p>
      <h2 id="paid-report-unavailable-title"><%= t("reports.paid_unavailable.title") %></h2>
      <p><%= t("reports.paid_unavailable.body") %></p>
    </div>
    <span class="report-unavailable__status-icon" aria-hidden="true"><%= mesto_icon("shield", css_class: "size-5") %></span>
  </header>

  <div class="report-section__body">
    <% if blocking_runs.any? %>
      <div class="report-unavailable__checks">
        <p class="report-unavailable__label"><%= t("reports.paid_unavailable.blocking_checks") %></p>
        <ul>
          <% blocking_runs.each do |run| %>
            <li>
              <span class="report-unavailable__check-icon" aria-hidden="true"><%= mesto_icon("document", css_class: "size-4") %></span>
              <div>
                <h3><%= source_name(run.source_key) %></h3>
                <% if (issue = source_issue_text(run, analysis:)) %>
                  <p><%= issue %></p>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% if dependent_runs.any? %>
      <p class="report-unavailable__dependency"><%= t("reports.paid_unavailable.location_dependencies", count: dependent_runs.count) %></p>
    <% end %>

    <footer class="report-unavailable__footer">
      <div>
        <strong><%= t("reports.paid_unavailable.no_charge") %></strong>
        <% unless outside_coverage %>
          <p><%= t("reports.paid_unavailable.retry_note") %></p>
        <% end %>
      </div>
      <% unless outside_coverage %>
        <%= button_to t("reports.refresh.action"), refresh_report_path(public_token: analysis), method: :post, class: "button button--secondary button--small" %>
      <% end %>
    </footer>
  </div>
</section>
