<section id="next-steps" class="report-section">
  <header class="report-section__header">
    <div>
      <p class="report-section-label"><%= t("reports.buyer_checklist.eyebrow") %></p>
      <h2><%= t("reports.buyer_checklist.title") %></h2>
      <p><%= t("reports.buyer_checklist.description") %></p>
    </div>
  </header>
  <div class="report-section__body">
  <ol class="grid gap-3 lg:grid-cols-2">
    <% items.each_with_index do |item, index| %>
      <li class="flex gap-4 rounded-2xl border border-slate-200 p-4">
        <span class="grid size-7 shrink-0 place-items-center rounded-full bg-slate-950 text-xs font-black text-white"><%= index + 1 %></span>
        <div>
          <span class="inline-flex rounded-full px-2.5 py-1 text-[10px] font-black uppercase tracking-wide <%= checklist_status_classes(item['status']) %>"><%= t("reports.buyer_checklist.statuses.#{item['status']}") %></span>
          <p class="mt-2 text-sm font-semibold leading-6 text-slate-800"><%= t("reports.buyer_checklist.items.#{item['key']}") %></p>
        </div>
      </li>
    <% end %>
  </ol>
  </div>
</section>
