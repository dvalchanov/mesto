<section class="report-education" id="education-next-move">
  <div class="report-education__heading">
    <div><p class="report-section-label"><%= localized_copy("Наръчник на Mesto", "Mesto guide") %></p><h2><%= localized_copy("Твоят следващ ход", "Your next move") %></h2><p><%= localized_copy("Откритите строителни документи и твоят етап са показани отделно. Всички обяснения в наръчника са безплатни.", "Construction documents we found and your own stage are shown separately. Every explanation in the guide is free.") %></p></div>
    <%= link_to localized_copy("Отвори наръчника", "Open the guide"), guide_path, class: "text-link" %>
  </div>
  <div class="report-education__context">
    <div><span><%= localized_copy("Твоят етап", "Your stage") %></span><strong><%= journey ? buyer_stage_label(journey.buyer_stage) : localized_copy("Още не е избран", "Not selected yet") %></strong><small><%= journey ? localized_copy("Посочен от теб", "Set by you") : localized_copy("Няма да го предполагаме от отчета", "We won't guess it from the report") %></small></div>
    <div><span><%= localized_copy("Етап според последния открит документ", "Stage based on the latest document found") %></span><strong><%= presenter.assessment&.milestone ? building_stage_label(presenter.assessment.milestone) : localized_copy("Не е установен", "Not established") %></strong><small><%= presenter.assessment&.source_checked_at ? localized_copy("Проверено на #{l(presenter.assessment.source_checked_at.to_date, format: :short)}", "Checked on #{l(presenter.assessment.source_checked_at.to_date, format: :short)}") : localized_copy("Източниците още не са проверени", "Sources not checked yet") %></small></div>
    <div><span><%= localized_copy("Какво остава неясно", "What remains unclear") %></span><strong><%= presenter.assessment&.limitations&.first || localized_copy("Прегледай за кои имоти и сгради се отнасят видимите записи.", "Review which properties and buildings the visible records refer to.") %></strong><small><%= localized_copy("„Не е открито“ не означава „не съществува“.", "\"Not found\" does not mean \"doesn't exist\".") %></small></div>
  </div>
  <% recommendations = presenter.recommendations.first(3) %>
  <% shared_reason = recommendations.map { |item| item["reason"] }.uniq.one? ? recommendations.first&.dig("reason") : nil %>
  <% if shared_reason.present? %><p class="report-education__reason"><%= shared_reason %></p><% end %>
  <div class="report-education__actions">
    <% recommendations.each do |item| %><%= link_to education_path_for(item) do %><span><%= localized_copy("Какво означава?", "What does it mean?") %></span><strong><%= item["title"] %></strong><% unless shared_reason %><small><%= item["reason"] %></small><% end %><% end %><% end %>
  </div>
  <% if journey %>
    <%= link_to localized_copy("Виж личния ми план", "See my personal plan"), my_mesto_path, class: "button button--secondary" %>
  <% else %>
    <div class="report-education__connect"><p><%= localized_copy("Искаш ли да получиш насоки според своя етап? Свържи отчета с личен план. Информацията в плана ти остава отделена от споделения отчет.", "Want guidance for your stage? Link the report to a personal plan. Your plan stays separate from the shared report.") %></p><%= button_to localized_copy("Свържи с личен план", "Link to personal plan"), attach_report_to_journey_path(public_token: analysis), method: :post, class: "button button--primary" %></div>
  <% end %>
</section>
