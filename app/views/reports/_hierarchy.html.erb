<section class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8">
  <h2 class="text-xl font-bold"><%= t("reports.hierarchy.title") %></h2>
  <div class="mt-6 space-y-3">
    <% [["parcel", analysis.parcel_identifier], ["building", analysis.building_identifier], ["individual_object", analysis.individual_object_identifier]].each do |level, value| %>
      <% next if value.blank? %>
      <div class="flex flex-col justify-between gap-2 rounded-2xl bg-slate-50 px-4 py-3 sm:flex-row sm:items-center">
        <span class="text-sm font-semibold text-slate-500"><%= t("reports.hierarchy.#{level}") %></span>
        <code class="break-all text-sm font-bold text-slate-900"><%= value %></code>
      </div>
    <% end %>
  </div>
</section>
