<details class="report-disclosure group rounded-lg border border-slate-200 bg-white">
  <summary class="report-disclosure__summary">
    <div>
      <p class="report-section-label"><%= t("reports.sources.eyebrow") %></p>
      <h2><%= t("reports.sources.title") %></h2>
      <p><%= t("reports.sources.summary", succeeded: coverage["succeeded"].to_i, checked: coverage["checked"].to_i) %></p>
    </div>
    <span class="disclosure-icon" aria-hidden="true"></span>
  </summary>
  <div class="px-6 pb-6 sm:px-8 sm:pb-8">
    <div class="divide-y divide-slate-100">
      <% source_runs.each do |run| %>
        <% result_key = source_result_key(run, analysis:) %>
        <article class="grid gap-3 py-5 sm:grid-cols-[1fr_auto] sm:items-start">
          <div>
            <h3 class="text-sm font-black leading-5 text-slate-900"><%= source_name(run.source_key) %></h3>
            <% if run.request_metadata["demo_data"] %>
              <p class="report-source-demo"><%= t("reports.sources.demo_data") %></p>
            <% end %>
            <p class="mt-1 text-xs leading-5 text-slate-500"><%= run.relevant_at ? t("common.relevant_at", date: l(run.relevant_at.to_date, format: :short)) : t("common.unknown_date") %></p>
            <% if (basis = run.request_metadata["geometry_basis"]).present? %>
              <p class="mt-1 text-xs leading-5 text-slate-500"><%= t("reports.sources.geometry_basis", basis: t("reports.sources.geometry_bases.#{basis}", default: basis.humanize)) %></p>
            <% end %>
            <% if (issue = source_issue_text(run, analysis:)) %><p class="mt-2 max-w-2xl text-xs font-semibold leading-5 text-amber-800"><%= issue %></p><% end %>
            <% if run.source_url.present? %><%= link_to t("common.source_link"), run.source_url, target: "_blank", rel: "noopener noreferrer", class: "report-source-link report-source-link--stacked" %><% end %>
          </div>
          <span class="source-result <%= source_result_classes(result_key) %>"><%= source_result_text(run, analysis:) %></span>
        </article>
      <% end %>
      <% if source_runs.empty? %><p class="py-5 text-sm text-slate-500"><%= t("reports.sources.empty") %></p><% end %>
    </div>
    <p class="rounded-sm bg-slate-50 p-4 text-xs leading-5 text-slate-600"><%= t("reports.sources.method_note") %></p>
  </div>
</details>
