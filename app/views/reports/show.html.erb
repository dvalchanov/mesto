<% content_for :title, "#{t('reports.title', identifier: @analysis.submitted_identifier)} - #{product_name}" %>
<% content_for :description, localized_copy("Личен отчет на Mesto за публичните данни, свързани с имот #{@analysis.submitted_identifier}.", "A private Mesto report covering public data associated with property #{@analysis.submitted_identifier}.") %>
<% content_for :head do %><meta name="robots" content="noindex,nofollow"><% end %>
<%= turbo_stream_from @analysis, I18n.locale %>

<section class="site-shell report-page">
  <header class="report-hero">
    <div class="report-hero__main">
      <div class="report-hero__identity">
        <p class="report-hero__status"><i></i><%= t("reports.status_label") %> · <%= t("reports.statuses.#{@analysis.status}") %></p>
        <h1><%= @analysis.submitted_identifier %></h1>
        <div class="report-hero__meta">
          <span><%= mesto_icon("building", css_class: "size-4") %><%= t("reports.hierarchy.levels.#{@analysis.identifier_level}") %></span>
          <% if @analysis.completed_at %><span><%= mesto_icon("check", css_class: "size-4") %><%= l(@analysis.completed_at, format: :short) %></span><% end %>
          <span><%= mesto_icon("shield", css_class: "size-4") %><%= t("common.official_source") %></span>
        </div>
      </div>
      <div class="report-actions">
        <%= link_to root_path, class: "button button--secondary" do %><%= mesto_icon("search", css_class: "size-4") %><%= t("navigation.new_search") %><% end %>
      </div>
    </div>
  </header>

  <% if @analysis.running? %>
    <%= render "progress", analysis: @analysis %>
  <% else %>
    <div class="report-layout">
      <aside class="report-toc">
        <p><%= t("reports.navigation.title") %></p>
        <nav aria-label="<%= t('reports.title', identifier: @analysis.submitted_identifier) %>">
          <a href="#overview" data-turbo="false"><span><%= mesto_icon("spark", css_class: "size-3.5") %></span><%= t("reports.navigation.overview") %></a>
          <a href="#identity" data-turbo="false"><span>01</span><%= t("reports.property_facts.title") %></a>
          <a href="#records" data-turbo="false"><span>02</span><%= t("reports.findings.title") %></a>
          <a href="#ownership" data-turbo="false"><span>03</span><%= t("reports.property_graph.nav") %></a>
          <a href="#context" data-turbo="false"><span>04</span><%= t("reports.neighborhood.title") %></a>
          <a href="#next-steps" data-turbo="false"><span>05</span><%= t("reports.buyer_checklist.title") %></a>
          <a href="#sources" data-turbo="false"><span><%= mesto_icon("shield", css_class: "size-3.5") %></span><%= t("reports.sources.title") %></a>
        </nav>
      </aside>

      <div class="report-layout__content">
        <% if @analysis.status == "partial" %><div class="report-alert"><%= t(@analysis.full_report_unlocked? ? "reports.partial_notice_unlocked" : "reports.partial_notice") %></div><% end %>
        <% if @analysis.summary["outside_sofia"] %>
          <div class="report-alert"><strong><%= t("reports.outside_sofia.title") %></strong><br><%= t("reports.outside_sofia.body") %></div>
        <% elsif @analysis.summary["outside_development_dataset"] %>
          <div class="report-alert"><strong><%= t("reports.outside_dataset.title") %></strong><br><%= t("reports.outside_dataset.body", profile: @analysis.summary.dig("coverage_profile", "label")) %></div>
        <% elsif @analysis.status == "failed" %>
          <div class="report-alert"><strong><%= t("reports.failed.title") %></strong><br><%= t("reports.failed.body") %></div>
        <% end %>

        <%= render "overview", facts: @property_facts, coverage: @coverage %>

        <div class="report-stack">
          <%= render "free_report", analysis: @analysis, property_facts: @property_facts, property_graph: @property_graph, preview_acts: @preview_acts, buyer_checklist: @buyer_checklist, due_diligence: @due_diligence, map_acts: @acts %>

          <% if @analysis.full_report_unlocked? %>
            <%= render "full_report", analysis: @analysis, acts: @acts, source_runs: @source_runs %>
          <% elsif @analysis.meaningful_paid_content? %>
            <%= render "locked_report", analysis: @analysis %>
          <% else %>
            <%= render "paid_report_unavailable", analysis: @analysis, source_runs: @source_runs %>
          <% end %>

          <div class="space-y-5" id="sources">
            <%= render "sources", analysis: @analysis, source_runs: @source_runs, coverage: @coverage %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</section>
