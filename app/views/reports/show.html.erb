<% content_for :title, "#{t('reports.title', identifier: @analysis.submitted_identifier)} — #{product_name}" %>

<section class="mx-auto max-w-7xl px-5 py-10 sm:px-8 sm:py-14" data-controller="poll" data-poll-active-value="<%= @analysis.running? %>">
  <div class="mb-8 flex flex-col gap-5 border-b border-slate-200 pb-8 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="mb-2 text-xs font-bold uppercase tracking-[0.16em] text-emerald-700"><%= t("reports.status_label") %> · <%= t("reports.statuses.#{@analysis.status}") %></p>
      <h1 class="break-all font-mono text-2xl font-bold tracking-tight sm:text-4xl"><%= @analysis.submitted_identifier %></h1>
    </div>
    <%= link_to t("navigation.new_search"), root_path, class: "inline-flex rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-bold text-slate-800 hover:border-slate-400" %>
  </div>

  <% if @analysis.running? %>
    <%= render "progress", analysis: @analysis %>
  <% else %>
    <% if @analysis.status == "partial" %>
      <div class="mb-7 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm leading-6 text-amber-950"><%= t("reports.partial_notice") %></div>
    <% end %>
    <% if @analysis.summary["outside_sofia"] %>
      <div class="mb-8 rounded-3xl border border-sky-200 bg-sky-50 p-7">
        <h2 class="text-xl font-bold text-sky-950"><%= t("reports.outside_sofia.title") %></h2>
        <p class="mt-3 max-w-4xl leading-7 text-sky-900"><%= t("reports.outside_sofia.body") %></p>
      </div>
    <% elsif @analysis.status == "failed" %>
      <div class="mb-8 rounded-3xl border border-rose-200 bg-rose-50 p-7">
        <h2 class="text-xl font-bold text-rose-950"><%= t("reports.failed.title") %></h2>
        <p class="mt-3 text-rose-900"><%= t("reports.failed.body") %></p>
      </div>
    <% end %>

    <%= render "free_report", analysis: @analysis, property_facts: @property_facts, preview_acts: @preview_acts, buyer_checklist: @buyer_checklist %>

    <% if @analysis.full_report_unlocked? %>
      <%= render "full_report", analysis: @analysis, acts: @acts, source_runs: @source_runs %>
    <% elsif @analysis.meaningful_paid_content? %>
      <%= render "locked_report", analysis: @analysis %>
    <% else %>
      <div class="mt-8 rounded-3xl border border-slate-200 bg-white p-8">
        <h2 class="text-xl font-bold"><%= t("reports.no_data.title") %></h2>
        <p class="mt-3 max-w-3xl leading-7 text-slate-600"><%= t("reports.no_data.body") %></p>
      </div>
    <% end %>

    <div class="mt-8 space-y-6">
      <%= render "sources", analysis: @analysis, source_runs: @source_runs, coverage: @coverage %>
      <%= render "not_verified" %>
    </div>
  <% end %>
</section>
