<% content_for :title, "#{t('reports.title', identifier: @analysis.submitted_identifier)} — #{product_name}" %>
<%= turbo_stream_from @analysis, I18n.locale %>

<section class="site-shell report-page">
  <header class="report-hero">
    <div class="report-hero__main">
      <div>
        <p class="report-hero__status"><i></i><%= t("reports.status_label") %> · <%= t("reports.statuses.#{@analysis.status}") %></p>
        <h1><%= @analysis.submitted_identifier %></h1>
        <div class="report-hero__meta">
          <span><%= mesto_icon("building", css_class: "size-4") %><%= t("reports.hierarchy.levels.#{@analysis.identifier_level}") %></span>
          <% if @analysis.completed_at %><span><%= mesto_icon("check", css_class: "size-4") %><%= l(@analysis.completed_at, format: :short) %></span><% end %>
          <span><%= mesto_icon("shield", css_class: "size-4") %><%= t("common.official_source") %></span>
        </div>
      </div>
      <div class="report-actions">
        <%= link_to root_path, class: "button button--ink" do %><%= mesto_icon("search", css_class: "size-4") %><%= t("navigation.new_search") %><% end %>
      </div>
    </div>
    <% unless @analysis.running? %>
      <nav class="report-hero__nav" aria-label="<%= t('reports.title', identifier: @analysis.submitted_identifier) %>">
        <a href="#overview"><%= t("reports.full.overview") %></a>
        <a href="#records"><%= t("reports.findings.title") %></a>
        <a href="#context"><%= t("reports.neighborhood.title") %></a>
        <a href="#next-steps"><%= t("reports.buyer_checklist.title") %></a>
        <a href="#sources"><%= t("reports.sources.title") %></a>
      </nav>
    <% end %>
  </header>

  <% if @analysis.running? %>
    <%= render "progress", analysis: @analysis %>
  <% else %>
    <dl class="report-coverage">
      <div><dt><%= t("reports.coverage.title") %></dt><dd><%= t("reports.coverage.#{@coverage['status'] || 'limited'}") %></dd></div>
      <div><dt><%= t("reports.sources.title") %></dt><dd><%= @coverage["succeeded"].to_i %> / <%= @coverage["checked"].to_i %></dd></div>
      <div><dt><%= t("reports.overview.direct_acts") %></dt><dd><%= @analysis.metrics.dig("direct_activity", "total").to_i %></dd></div>
    </dl>

    <% if @analysis.status == "partial" %><div class="report-alert"><%= t(@analysis.full_report_unlocked? ? "reports.partial_notice_unlocked" : "reports.partial_notice") %></div><% end %>
    <% if @analysis.summary["outside_sofia"] %>
      <div class="report-alert"><strong><%= t("reports.outside_sofia.title") %></strong><br><%= t("reports.outside_sofia.body") %></div>
    <% elsif @analysis.status == "failed" %>
      <div class="report-alert"><strong><%= t("reports.failed.title") %></strong><br><%= t("reports.failed.body") %></div>
    <% end %>

    <div class="report-stack">
      <%= render "free_report", analysis: @analysis, property_facts: @property_facts, preview_acts: @preview_acts, buyer_checklist: @buyer_checklist, due_diligence: @due_diligence, map_acts: @acts %>

      <% if @analysis.full_report_unlocked? %>
        <%= render "full_report", analysis: @analysis, acts: @acts, source_runs: @source_runs %>
      <% elsif @analysis.meaningful_paid_content? %>
        <%= render "locked_report", analysis: @analysis %>
      <% else %>
        <%= render "paid_report_unavailable", analysis: @analysis, source_runs: @source_runs %>
      <% end %>

      <div class="space-y-5" id="sources">
        <%= render "sources", analysis: @analysis, source_runs: @source_runs, coverage: @coverage %>
        <%= render "not_verified" %>
      </div>
    </div>
  <% end %>
</section>
