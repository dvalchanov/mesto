<section id="context" class="rounded-[2rem] border border-slate-200 bg-white p-6 sm:p-8">
  <p class="report-section-label text-xs font-black uppercase tracking-[0.16em] text-emerald-700"><%= t("reports.neighborhood.eyebrow") %></p>
  <h2 class="mt-2 text-2xl font-black tracking-tight"><%= t("reports.neighborhood.title") %></h2>
  <% if analysis.centroid %>
    <p class="mt-2 text-sm leading-6 text-slate-600"><%= t("reports.neighborhood.description", precision: t("reports.map.precisions.#{analysis.location_precision}")) %></p>
    <% amenities = analysis.metrics.fetch("amenities", {}) %>
    <% environment = analysis.metrics.fetch("environment", {}) %>
    <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <% %w[schools kindergartens].each do |category| %>
        <% available = amenities.dig("availability", category) %>
        <div class="rounded-2xl <%= category == 'schools' ? 'bg-sky-50' : 'bg-violet-50' %> p-5">
          <p class="text-2xl font-black <%= category == 'schools' ? 'text-sky-950' : 'text-violet-950' %>"><%= available ? amenities.dig(category, "1000").to_i : "—" %></p>
          <p class="mt-1 text-xs font-bold leading-5 <%= category == 'schools' ? 'text-sky-800' : 'text-violet-800' %>"><%= t("reports.neighborhood.#{category}") %></p>
          <p class="mt-2 text-[11px] leading-4 text-slate-600"><%= available ? dataset_relevance_text(amenities.dig("datasets", category)) : t("reports.neighborhood.not_calculated") %></p>
        </div>
      <% end %>
      <div class="rounded-2xl bg-amber-50 p-5">
        <p class="text-2xl font-black text-amber-950">—</p>
        <p class="mt-1 text-xs font-bold leading-5 text-amber-800"><%= t("reports.neighborhood.acts") %></p>
        <p class="mt-2 text-[11px] leading-4 text-slate-600"><%= t("reports.neighborhood.activity_not_assessed") %></p>
      </div>
      <div class="rounded-2xl bg-emerald-50 p-5">
        <p class="text-2xl font-black text-emerald-950"><%= environment["available"] ? environment["flood_risk_intersections"].to_i : "—" %></p>
        <p class="mt-1 text-xs font-bold leading-5 text-emerald-800"><%= t("reports.neighborhood.flood") %></p>
        <p class="mt-2 text-[11px] leading-4 text-slate-600"><%= environment["available"] ? dataset_relevance_text(environment["dataset"]) : t("reports.neighborhood.not_calculated") %></p>
      </div>
    </div>
    <p class="mt-3 text-xs leading-5 text-slate-500"><%= t("reports.neighborhood.dataset_scope_note") %></p>
    <div class="mt-4 grid gap-3 sm:grid-cols-3">
      <% [
        ["transit", "nearest_existing_transit", "existing_transit"],
        ["transit", "nearest_planned_transit", "planned_transit"],
        ["green_spaces", "nearest_green_space", "green_space"]
      ].each do |category, key, label| %>
        <% nearest = amenities[key] %>
        <div class="rounded-2xl border border-slate-200 p-4 text-sm">
          <p class="text-xs font-semibold text-slate-500"><%= t("reports.neighborhood.#{label}") %></p>
          <p class="mt-1 font-bold text-slate-900"><%= if amenities.dig("availability", category)
            nearest ? t("reports.full.nearest", name: nearest["name"].presence || t("reports.neighborhood.#{label}"), distance: nearest["distance_m"]) : t("reports.neighborhood.not_found")
          else
            t("reports.neighborhood.not_calculated")
          end %></p>
        </div>
      <% end %>
    </div>
    <div class="mt-6"><%= render "map", analysis:, acts: %></div>
  <% else %>
    <div class="mt-6 rounded-2xl border border-amber-200 bg-amber-50 p-5 sm:p-6">
      <h3 class="font-black text-amber-950"><%= t("reports.neighborhood.location_missing_title") %></h3>
      <p class="mt-2 max-w-4xl text-sm leading-6 text-amber-900"><%= t("reports.neighborhood.location_missing_body") %></p>
      <p class="mt-3 text-sm font-bold text-amber-950"><%= t("reports.neighborhood.location_missing_action") %></p>
    </div>
  <% end %>
</section>
