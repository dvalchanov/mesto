<section id="context" class="rounded-[2rem] border border-slate-200 bg-white p-6 sm:p-8">
  <p class="report-section-label text-xs font-black uppercase tracking-[0.16em] text-emerald-700"><%= t("reports.neighborhood.eyebrow") %></p>
  <h2 class="mt-2 text-2xl font-black tracking-tight"><%= t("reports.neighborhood.title") %></h2>
  <% if analysis.centroid %>
    <p class="mt-2 text-sm leading-6 text-slate-600"><%= t("reports.neighborhood.description", precision: t("reports.map.precisions.#{analysis.location_precision}")) %></p>
    <% amenities = analysis.metrics.fetch("amenities", {}) %>
    <% nearby = analysis.metrics.fetch("nearby_activity", {}) %>
    <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-2xl bg-sky-50 p-5"><p class="text-2xl font-black text-sky-950"><%= amenities.dig("schools", "1000").to_i %></p><p class="mt-1 text-xs font-bold leading-5 text-sky-800"><%= t("reports.neighborhood.schools") %></p></div>
      <div class="rounded-2xl bg-violet-50 p-5"><p class="text-2xl font-black text-violet-950"><%= amenities.dig("kindergartens", "1000").to_i %></p><p class="mt-1 text-xs font-bold leading-5 text-violet-800"><%= t("reports.neighborhood.kindergartens") %></p></div>
      <div class="rounded-2xl bg-amber-50 p-5"><p class="text-2xl font-black text-amber-950"><%= nearby.dig("counts", "500").to_i %></p><p class="mt-1 text-xs font-bold leading-5 text-amber-800"><%= t("reports.neighborhood.acts") %></p></div>
      <div class="rounded-2xl bg-emerald-50 p-5"><p class="text-2xl font-black text-emerald-950"><%= analysis.metrics.dig("environment", "flood_risk_intersections").to_i %></p><p class="mt-1 text-xs font-bold leading-5 text-emerald-800"><%= t("reports.neighborhood.flood") %></p></div>
    </div>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      <% [["nearest_transit", "transit"], ["nearest_green_space", "green_space"]].each do |key, label| %>
        <% nearest = amenities[key] %>
        <div class="rounded-2xl border border-slate-200 p-4 text-sm">
          <p class="text-xs font-semibold text-slate-500"><%= t("reports.neighborhood.#{label}") %></p>
          <p class="mt-1 font-bold text-slate-900"><%= nearest ? t("reports.full.nearest", name: nearest["name"].presence || t("reports.neighborhood.unnamed"), distance: nearest["distance_m"]) : t("reports.neighborhood.not_found") %></p>
        </div>
      <% end %>
    </div>
    <div class="mt-6"><%= render "map", analysis:, acts: AdministrativeAct.none %></div>
  <% else %>
    <div class="mt-6 rounded-2xl border border-amber-200 bg-amber-50 p-5 sm:p-6">
      <h3 class="font-black text-amber-950"><%= t("reports.neighborhood.location_missing_title") %></h3>
      <p class="mt-2 max-w-4xl text-sm leading-6 text-amber-900"><%= t("reports.neighborhood.location_missing_body") %></p>
      <p class="mt-3 text-sm font-bold text-amber-950"><%= t("reports.neighborhood.location_missing_action") %></p>
    </div>
  <% end %>
</section>
