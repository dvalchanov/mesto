<div class="mx-auto max-w-3xl rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-9">
  <div class="mb-8">
    <h2 class="text-2xl font-bold tracking-tight"><%= t("reports.progress.title") %></h2>
    <p class="mt-2 leading-7 text-slate-600"><%= t("reports.progress.description") %></p>
  </div>
  <ol class="space-y-3">
    <% Analysis::Runner::STAGES.each_with_index do |stage, index| %>
      <% progress = analysis.progress.find { |item| item["key"] == stage } %>
      <% state = progress&.fetch("status", nil) || (index.zero? ? "active" : "pending") %>
      <li class="flex items-center gap-4 rounded-2xl border border-slate-200 px-4 py-4">
        <span class="grid size-9 shrink-0 place-items-center rounded-full text-sm font-black <%= state == 'active' ? 'bg-sky-600 text-white animate-pulse' : state == 'completed' ? 'bg-emerald-600 text-white' : state == 'failed' ? 'bg-rose-600 text-white' : 'bg-slate-100 text-slate-500' %>"><%= progress_icon(state) %></span>
        <div class="min-w-0 flex-1">
          <p class="font-bold text-slate-900"><%= t("reports.progress.#{stage}") %></p>
          <p class="mt-0.5 text-xs font-semibold uppercase tracking-wider text-slate-500"><%= t("reports.progress.states.#{state}") %></p>
        </div>
      </li>
    <% end %>
  </ol>
</div>
