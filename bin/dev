#!/usr/bin/env sh

if ! gem list foreman -i --silent; then
  echo "Installing foreman..."
  gem install foreman
fi

# All worktrees use the Compose project's shared PostgreSQL and Redis services.
# `docker compose up` is a no-op when the healthy services are already running.
docker compose up -d --wait || exit 1
docker compose exec -T postgres sh -c \
  'PGOPTIONS="--client-min-messages=warning" psql --quiet --set ON_ERROR_STOP=1 --username "$POSTGRES_USER" --dbname "$POSTGRES_DB"' \
  < docker/postgres/init/20_remove_optional_extensions.sql || exit 1

bin/rails db:prepare || exit 1

# A fixed port keeps the local URL stable when moving between worktrees.
export PORT="${PORT:-3000}"

# Let the debug gem allow remote connections,
# but avoid loading until `debugger` is called
export RUBY_DEBUG_OPEN="true"
export RUBY_DEBUG_LAZY="true"

exec foreman start -f Procfile.dev "$@"
