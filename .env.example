# Copy to .env and replace only local infrastructure placeholders.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=mesto
DATABASE_PASSWORD=replace_with_local_password
DATABASE_NAME=mesto_development
TEST_DATABASE_NAME=mesto_test
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
REDIS_SSL_VERIFY_MODE=peer
REDIS_CACHE_POOL=2
SIDEKIQ_REDIS_POOL=3
SIDEKIQ_CLIENT_REDIS_POOL=2
WEB_CONCURRENCY=1
RAILS_MAX_THREADS=5
DB_POOL=5
SIDEKIQ_CONCURRENCY=3
INGESTION_CONCURRENCY=1

# Required to access Sidekiq Web in production. Leave blank in local development.
SIDEKIQ_WEB_USERNAME=
SIDEKIQ_WEB_PASSWORD=

# Durable source archives are required by default in production when ingestion runs.
SOURCE_ARCHIVE_REQUIRED=false
SOURCE_ARCHIVE_BUCKET=
SOURCE_ARCHIVE_REGION=eu-west-1
SOURCE_ARCHIVE_PREFIX=development
SOURCE_ARCHIVE_EXPECTED_BUCKET_OWNER=
SOURCE_ARCHIVE_MULTIPART_THRESHOLD_BYTES=104857600
SOURCE_ARCHIVE_UPLOAD_THREADS=1

PRODUCT_NAME=Mesto
APP_HOST=mesto.bg
MAIL_FROM="Mesto <hello@mesto.bg>"
DATA_SOURCE_MODE=live
STORE_RAW_SOURCE_RESPONSES=false

# Opt-in synthetic Registry Agency responses for the complete local UI demo only.
MESTO_REGISTRY_DEMO=false
MESTO_REGISTRY_DEMO_IDENTIFIER=68134.1607.1254.1.5

SOFIAPLAN_API_BASE_URL=https://api.sofiaplan.bg
SOFIAPLAN_ARCGIS_DEVELOPMENT_POTENTIAL_URL=https://gis.sofiaplan.bg/server/rest/services/programa_za_sofia/programa_sofia_atlas_na_analizite/FeatureServer/31
SOFIAPLAN_ARCGIS_FUNCTIONAL_ZONING_URL=https://gis.sofiaplan.bg/server/rest/services/programa_za_sofia/programa_sofia_atlas_na_analizite/FeatureServer/33
VIES_SERVICE_URL=https://ec.europa.eu/taxation_customs/vies/services/checkVatService

NAG_BUILDING_PERMITS_URL=https://nag.sofia.bg/RegisterBuildingPermitsPortal/Index
NAG_DESIGN_VISAS_URL=https://nag.sofia.bg/registervisasofproection
NAG_URBAN_PLANNING_ORDERS_URL=https://nag.sofia.bg/registerurbanplanningorders
NAG_OCCUPANCY_CERTIFICATES_URL=https://nag.sofia.bg/RegisterCertificateForExploitationBuildings
NAG_ON_DEMAND_INGESTION_ENABLED=true
NAG_SUCCESSFUL_SNAPSHOT_MAX_AGE=86400
NAG_FAILED_SNAPSHOT_MAX_AGE=900
NAG_PERMISSION_STATUS=review_required

CADASTRE_PROVIDER=open_data
CADASTRE_MAX_ARCHIVE_BYTES=1073741824

# Demo style is used when blank; choose a production tile provider before launch.
MAP_STYLE_URL=

PAYMENT_PROVIDER=fake
FAKE_PAYMENTS_ENABLED=true
CHECKOUT_ENABLED=true
DEVELOPMENT_PRESSURE_YEARS=5
ANONYMOUS_JOURNEY_RETENTION_DAYS=180
